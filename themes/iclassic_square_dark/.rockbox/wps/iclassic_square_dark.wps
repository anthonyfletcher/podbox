#-----------------------------------------------#
#
#Colours: bright is the album's lighter colour, white with
#none, and bright.75 a shade of it. Every other colour is
#pinned with !, so it stays as written.
#
#Status bar off
%wd
#
#Preload fonts
%Fl(2,24x24-icons.fnt)
%Fl(3,18-noto-sans-bold.fnt)
%Fl(4,16-noto-sans-bold.fnt)
%Fl(5,16-noto-sans.fnt)
#
#Background layer
#
#- Title bar
%V(0,0,-,-,-)%VB%Vb(!000000)%Vf(!ffffff)
%dr(0,0,320,23,!2c2c2c,!141414)
%dr(0,23,320,1,!505050)
#
#- Progress track. Here, not %Vb: %pb clears to the backdrop
%dr(60,214,200,6,!2a2a2a)
%dr(60,220,200,6,!202020)
#
#- Cover or grey tile, and the reflection fade. Same size as the .sbs cover
%?C<|%dr(8,32,150,150,!3a3a3a,!202020)>
%dr(8,184,150,22,!1c1c1c,!000000)
%Cl(8,32,150,150,c,c)%Cd
#
#Foreground layer
#
#- Volume or progress. 1x1 because a flip clears its line
%V(319,239,1,1,-)
%?mv(2)<%Vd(Volume)|%Vd(Progress)>
#
#- Title
%V(6,3,190,19,4)%Vf(!ffffff)
%Sx(Now Playing)
#
#- Status icons
%V(198,0,120,23,2)%Vf(!ffffff)
%ar%?ps<I|>%?mm<|K|L|H|K>%?or(%lh,%lb,%lw)<%?la<á|â|ã|ä|å|æ|ç|è>|>%?mh<À|%?mp<|A|B|G|F>>%?bc<%?bl<·|·|¸|¸|¸|¸|¹|º>|%?bl<1|1|2|3|4|5|6|7>>
#
#- Grey tile's note
%V(71,95,24,24,2)%Vf(!909090)
%?C<|b>
#
#Track
#
#- Title, artist, album
%V(170,36,146,22,3)%Vf(!ffffff)
%s%?it<%it|%fn>
%V(170,60,146,20,4)%Vf(!909090)
%s%?ia<%ia|%?d(2)<%d(2)|>>
%V(170,80,146,20,5)%Vf(!909090)
%s%?id<%id|%?d(1)<%d(1)|>>
#
#- Rating
%V(170,102,146,24,2)%Vf(!909090)
%sel(%rr,1,±°°°°,2,²°°°°,3,²±°°°,4,²²°°°,5,²²±°°,6,²²²°°,7,²²²±°,8,²²²²°,9,²²²²±,10,²²²²²)
#
#- Playlist position
%V(170,128,146,20,5)%Vf(!909090)
%pp %Sx(of) %pe
#
#Progress, in two tones: bright over a shade of it
%Vl(Progress,2,210,52,20,4)%Vf(!ffffff)
%ar%pc
%Vl(Progress,60,214,200,6,-)%Vf(bright)
%pb(0,0,-,-,noborder)
%Vl(Progress,60,220,200,6,-)%Vf(bright.75)
%pb(0,0,-,-,noborder)
%Vl(Progress,266,210,52,20,4)%Vf(!ffffff)
%al-%pr
#
#Volume
%Vl(Volume,32,208,24,24,2)%Vf(!ffffff)
N
%Vl(Volume,60,214,200,6,-)%Vf(bright)
%pv(0,0,-,-,noborder)
%Vl(Volume,60,220,200,6,-)%Vf(bright.75)
%pv(0,0,-,-,noborder)
%Vl(Volume,264,208,24,24,2)%Vf(!ffffff)
O

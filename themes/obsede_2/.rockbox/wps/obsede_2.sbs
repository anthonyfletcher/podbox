#
# The selected row gets a bar a shade lighter than the background. It spans the full 
# 0..160 row width, on art rows and ordinary ones alike.
%Vl(Rows,0,0,7,21,6)%?La<|%?Lc<%Vb(2a2a2a)|%Vb(000000)>%?St(show icons)<%?if(%LI,>=,0)<%xd(icons,%LI,2)>>>

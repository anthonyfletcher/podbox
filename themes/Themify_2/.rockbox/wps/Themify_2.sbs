%Vl(Home_Menu_With_Icons_Panel,29,4,145,22,-)%?Lc<%Vs(invert)>%?if(%St(scroll speed),=,1)<|%s>%?if(%LT,=,%Sx(Now Playing))<%Sx(Now Playing): %?it<%it|%fn>|%LT>
%Vl(Home_Menu_No_Icons_Panel,0,0,182,30,6)%?Lc<%Vs(invert)A%aRB>

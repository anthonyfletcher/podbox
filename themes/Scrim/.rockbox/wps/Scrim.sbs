#
# - Row number
%Vl(Rows,36,7,24,20,3)
%?or(%if(%cs,=,5),%and(%if(%cs,=,8),%if(%LI,=,0),%if(%LT,!=,%Sx([All Tracks])),%if(%LT,!=,%Sx([Random])),%if(%LT,!=,%Sx([Untagged])),%if(%LT,!=,%Sx([By album]))))<%ar%?Lc<%Vf(ffffff)|%Vf(ababab)>%?if(%cs,=,5)<%LN|%ma(%LN,+,-1)>>

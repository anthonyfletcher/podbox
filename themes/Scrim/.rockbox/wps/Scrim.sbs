%Vi(-,10,46,300,184,-)
#
# Quick menu
%Vi(QuickArea,34,60,252,152,3)
%?if(%cs,=,10)<%VI(QuickArea)>
#
# Row setup
#
# - Row icon
%Vl(Rows,36,3,24,24,2)
%?La<|%?or(%if(%cs,=,5),%and(%if(%cs,=,8),%if(%LI,=,0),%if(%LT,!=,%Sx([All Tracks])),%if(%LT,!=,%Sx([Random])),%if(%LT,!=,%Sx([Untagged])),%if(%LT,!=,%Sx([By album]))))<|%?Lc<%Vf(ffffff)|%Vf(ababab)>%?if(%cs,=,7)<%sel(%LI,1,g,0,v,2,c,33,w,34,x,-1,-,y)|%sel(%LT,%Sx([All Tracks]),Z,%Sx([Random]),Î,%Sx([Untagged]),Ù,%Sx([By album]),U,%Sx(Now Playing),A,%Sx(Resume Playback),A,%Sx(Continue Reading),z,%Sx(Music),T,%Sx(Album Covers),V,%Sx(Artist Portraits),X,%Sx(Current Playlist),Í,%Sx(Playlists),c,%Sx(Spun),s,%Sx(Files),g,%Sx(Settings),£,%Sx(System),Ò,%Sx(Shortcuts),¾,%Sx(Random Album),Î,%Sx(Playback History),r,%Sx(Shuffle Songs),H,%Sx(Documents),z,%Sx(Images),¡,%Sx(Search),Þ,%Sx(Album),à,%Sx(Albums),à,%Sx(Artist),W,%Sx(Artists),W,%Sx(Album Artist),á,%Sx(Album Artists),á,%Sx(Genre),Y,%Sx(Year),t,%Sx(Composer),â,%Sx(User Rating),o,%Sx(Recently Added),q,%Sx(First Letter),k,%Sx(Tracks by),S,%Sx(Search by...),ß,%sel(%LT,%Sx(Same as currently played track),¼,%Sx(Sound Settings),±,%Sx(Playback Settings),ö,%Sx(Library),Ü,%Sx(Appearance),¦,%Sx(Battery & Power),³,%Sx(Settings Mode),ª,%Sx(Changed Settings),«,%Sx(Tracks),Z,%Sx(Artists between Years),è,%Sx(Albums between Years),ç,%Sx(Score),ó,%Sx(Comment),ò,%Sx(Add to Playlist...),ê,%Sx(Remove),Ï,%Sx(Move),ñ,%Sx(Show Track Info),i,%Sx(Shuffle),H,%Sx(Save),Ô,%Sx(View),¥,%Sx(Playing Next...),d,%Sx(Rename),ð,%Sx(Properties),i,%Sx(Delete),Ï,%Sx(Add to Shortcuts),¾,%Sx(Sort Playlist),¾,%Sx(Cut),ï,%Sx(Copy),î,%Sx(Paste),ô,%Sx(Delete Directory),í,%Sx(Create Directory),ì,%Sx(Set As...),e,%Sx(Files),z,%sel(%LT,%Sx(Volume),O,%Sx(Bass),R,%Sx(Treble),R,%Sx(Equalizer),P,%Sx(Repeat),J,%Sx(Bookmarking),e,%Sx(Carousel),V,%Sx(Art Cache),¡,%Sx(Load Theme),¾,%Sx(Font),j,%Sx(Edit Main Menu),i,%Sx(Backlight),§,%Sx(Brightness),¯,%Sx(Idle Poweroff),´,%Sx(Time & Date Settings),p,%Sx(Show in Files),h,%Sx(View Current Playlist),Í,%Sx(Save Current Playlist),Ô,%Sx(Search in Playlist),Þ,%Sx(Playing Time),Ë,%Sx(Reshuffle),H,%Sx(Add),½,%Sx(Play),A,%sel(%LI,19,À,2,
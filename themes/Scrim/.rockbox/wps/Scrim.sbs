# Quick menu tint
%?if(%cs,=,10)<%dr(20,46,280,180,000000,-,6,11)>
#
#--- Foreground layer ---#
#
%V(0,0,-,-,-)
#
# Setup rows
%Lb(Rows,300,30)
#
# Top bar
%?mv(3)<%Vd(Volume)|%Vd(Chrome)>
#
# List title
%Vl(Chrome,0,0,320,35,3)
%Vl(Chrome,10,7,180,20,3)%Vf(000000)
%?if(%cs,=,10)<Quick Screen|%?if(%Lt,=,Rockbox)<Main Menu|%s%Lt>>
#
# Status icons
%Vl(Chrome,190,5,120,24,2)%Vf(000000)

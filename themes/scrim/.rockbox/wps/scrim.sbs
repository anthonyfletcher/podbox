#-----------------------------------------------#
#
#--- Fonts ---#
%Fl(2,24x24-icons.fnt)
%Fl(3,18-noto-sans-bold.fnt)
%Fl(4,18-noto-sans.fnt)
#
#--- Images ---#
# The volume bar's track and fill; see the overlay at the end of the file.
%xl(vbg,volband.bmp,0,0)
%xl(vwf,volfill.bmp,0,0)
#
#--- Background layer ---#
#
# Album art, its highlights brought down until the list text reads. That text
# is white in every Dynamic Colors Background mode, so the scrim is for white.
%V(0,0,-,-,-)%VB%Vf(000000)%Vb(dominant<15:000000)%Cl(0,-40,320,320,c,c,blur12+scrim:ffffff+dither,-,blurred)%Cd(blurred)
#
# Background panels: a light wash of the album's background colour. The scrim
# on the art is what makes the white and tinted rows read.
%dr(0,0,320,35,ffffff,-,12)
%dr(0,35,320,205,dominant<40:000000,-,3)
#
# A podcast episode's notes, under a shorter list, unless episode notes is off
# in scrim.preferences
%?and(%LD,%if(%ft(themes/scrim.preferences,episode notes:),!=,off))<%dr(5,172,310,62,ffffff,-,3,6)>
#
# An album's header, over its tracks, unless album header is off in
# scrim.preferences
%?and(%if(%LH,=,album),%if(%ft(themes/scrim.preferences,album header:),!=,off))<%dr(5,40,310,70,ffffff,-,3,6)>
#
# Quick settings boxes
%?if(%cs,=,10)<%?if(%QL,!=,ERR)<%dr(12,62,144,72,ffffff,-,3,10)>%?if(%QT,!=,ERR)<%dr(164,62,144,72,ffffff,-,3,10)>%?if(%QR,!=,ERR)<%dr(12,142,144,72,ffffff,-,3,10)>%?if(%QB,!=,ERR)<%dr(164,142,144,72,ffffff,-,3,10)>>
#
#--- Foreground layer ---#
#
# Order is load-bearing. A conditional that flips runs write_line(), which clears
# its line's rect first -- text or not. 
%V(0,0,-,-,-)
#
# Top bar
%?mv(3)<%Vd(Volume)|%Vd(Chrome)%?St(battery display)<%Vd(ChromeG)|%Vd(ChromeN)>>
#
# Quick settings. Cover Flow's %VI rides this line because a conditional
# that flips clears its line's rect, and so does the shorter list a podcast's
# episodes take for their notes.
%?if(%cs,=,10)<%?if(%QL,!=,ERR)<%Vd(QuickL)>%?if(%QT,!=,ERR)<%Vd(QuickT)>%?if(%QR,!=,ERR)<%Vd(QuickR)>%?if(%QB,!=,ERR)<%Vd(QuickB)>>%?if(%cs,=,22)<%VI(covers)>%?and(%LD,%if(%ft(themes/scrim.preferences,episode notes:),!=,off))<%Vd(Notes)%VI(notes)>%?Ld<%VI(art)>%?and(%if(%LH,=,album),%if(%ft(themes/scrim.preferences,album header:),!=,off))<%Vd(AlbumHead)%VI(album)>
#
# Setup rows
%Lb(Rows,300,30,-,48)
#
# A numeric battery display adds the percentage after the time, so the title
# and the time have a ChromeG (graphic) and a ChromeN (numeric) copy: the
# time clears its whole viewport, so each starts where its title ends.
#
# - Title
%Vl(Chrome,0,0,320,35,3)
%Vl(ChromeG,10,8,200,20,3)%Vf(000000)
%?if(%cs,=,10)<%Sx(Quick Settings)|%?if(%Lt,=,Rockbox)<PodBox|%?and(%if(%LH,=,album),%if(%ft(themes/scrim.preferences,album header:),!=,off))<%Sx(Album)|%s%Lt%?and(%if(%LH,=,album),%if(%ft(themes/scrim.preferences,album header:),=,off),%LH(year))< %(%LH(year)%)>>>>
%Vl(ChromeN,10,8,152,20,3)%Vf(000000)
%?if(%cs,=,10)<%Sx(Quick Settings)|%?if(%Lt,=,Rockbox)<PodBox|%?and(%if(%LH,=,album),%if(%ft(themes/scrim.preferences,album header:),!=,off))<%Sx(Album)|%s%Lt%?and(%if(%LH,=,album),%if(%ft(themes/scrim.preferences,album header:),=,off),%LH(year))< %(%LH(year)%)>>>>
#
# - Status icons. The charging glyphs mirror the level glyphs band for
#   band; one covers levels 2 to 5, so it stands in four places.
%Vl(Chrome,289,5,24,24,2)%Vf(000000)
%ar%?or(%lh,%lb,%lw)<%?la<á|â|ã|ä|å|æ|ç|è>|%?bc<%?bl<·|·|¸|¸|¸|¸|¹|º>|%?bl<1|1|2|3|4|5|6|7>>>
#
# - Time, and the battery percentage when the display is numeric
%Vl(ChromeG,210,8,70,24,1)%Vf(000000)
%ar%?cf<%cH:%cM|%cl:%cM %cP>
%Vl(ChromeN,162,8,118,24,1)%Vf(000000)
%ar%?cf<%cH:%cM|%cl:%cM %cP>  %bl%%
#
# List viewport
%Vi(-,10,46,300,184,-)
#
# Cover Flow viewport. That screen takes only the top edge from %Vi and
# fills the rest of the screen itself, so it needs one without the list's
# padding.
%Vi(covers,0,35,320,205,-)
#
# A podcast's episodes: four rows, and the selected one's notes below them
%Vi(notes,10,46,300,122,-)
#
# An album's tracks: four rows under its header
%Vi(album,10,114,300,120,-)
#
# Album and artist art rows: four of them at 48px, the list a little
# taller than the others for it
%Vi(art,10,41,300,192,-)
#
# Row setup
#
# - Row shape. 1 icon, 2 number, 3 bare. A library list's own rows (%Lk 5:
#   <Random>, <Resume>, <Featured In>, the groupings a
#   tagnavi %header level puts above an artist's albums) have no track
#   number, so they take the icon shape, as do the database's top menus, Music
#   and Audiobooks, the Books menu (%cs 38) and the Arcade (%cs 40). <All Tracks> and <By album> stay bare, in line with the
#   album and artist rows they head. A genre called Audiobooks lists
#   containers (%Lk 6), so it is not one. Custom menu's rows take the icon
#   shape too, as do the user's own rows wherever they are (%Lk 10 and 11).
#   A track is numbered only where its list numbers it (%Lp): a podcast's
#   episodes across its shows go bare.
%Vl(Rows,0,0,1,1,-)
%?Lm<%vs(shape,set,1)|%?or(%if(%cs,=,1),%if(%cs,=,7),%if(%cs,=,13),%if(%cs,=,27),%if(%cs,=,28),%if(%cs,=,40),%and(%if(%cs,=,6),%if(%Lt,=,%Sx(Settings))),%and(%if(%cs,=,16),%if(%Lt,=,%Sx(System))),%and(%if(%cs,=,8),%or(%if(%Lk,=,1),%if(%Lk,=,4)),%or(%if(%Lt,=,%Sx(Music)),%if(%Lt,=,%Sx(Audiobooks)),%if(%Lt,=,%Sx(Podcasts)))),%and(%if(%cs,=,38),%if(%Lt,=,%Sx(Books))),%and(%if(%cs,=,8),%if(%Lk,=,5),%if(%LT,!=,%Sx([All Tracks])),%if(%LT,!=,%Sx([By album]))),%and(%if(%cs,=,8),%or(%if(%Lk,=,10),%if(%Lk,=,11),%if(%Lt,=,%Sx(Custom menu)))))<%vs(shape,set,1)|%?or(%if(%cs,=,5),%and(%if(%cs,=,8),%if(%Lk,=,7),%Lp))<%vs(shape,set,2)|%vs(shape,set,3)>>>
#
# - Chevron, on rows that open a list: a settings or context submenu, a
#   folder, a database level above the tracks, a catalogue playlist. A Yes/No
#   setting shows a switch in its place and a number setting a slider; the
#   two toggles worded otherwise (First Button Press, Quick Screen) show
#   nothing. A setting set to Auto, or to a side (Left, Top), shows its icon.
#   The settings that are scales in words (Weak to Strong, Slow to Fast) show
#   a slider too, empty at Off; Animation's own Slow to Fast is a step shorter
#   than FF/RW Accel's. 2 for a chevron, 3 for a switch, 4 for a slider, 5
#   for a value's icon, 6 for a word scale, 7 for Animation, 1 for none: a
#   skin variable is never below 1.
%?and(%if(%Lk,=,2),%or(%if(%Lv,=,%Sx(Yes)),%if(%Lv,=,%Sx(No))))<%vs(chev,set,3)|%?or(%Lr,%and(%La,%Lv))<%vs(chev,set,4)|%?and(%if(%Lk,=,3),%if(%LT,=,%Sx(Animation)))<%vs(chev,set,7)|%?and(%if(%Lk,=,3),%or(%if(%LT,=,%Sx(Track Skip Beep)),%if(%LT,=,%Sx(Headphone Keyclick)),%if(%LT,=,%Sx(Auditory Fatigue Reduction)),%if(%LT,=,%Sx(FF/RW Accel)),%if(%LT,=,%Sx(Random Spin Length))))<%vs(chev,set,6)|%?and(%if(%Lk,=,3),%or(%if(%Lv,=,%Sx(Auto)),%if(%Lv,=,%Sx(Left)),%if(%Lv,=,%Sx(Centre)),%if(%Lv,=,%Sx(Right)),%if(%Lv,=,%Sx(Top)),%if(%Lv,=,%Sx(Bottom)),%if(%Lv,=,%Sx(Justified))))<%vs(chev,set,5)|%?or(%and(%or(%if(%cs,=,6),%if(%cs,=,15)),%if(%Lk,=,1)),%and(%or(%if(%cs,=,7),%if(%cs,=,8),%if(%cs,=,13),%if(%cs,=,27),%if(%cs,=,28)),%if(%LI,=,1)),%and(%if(%cs,=,13),%if(%LI,=,2)))<%vs(chev,set,2)|%vs(chev,set,1)>>>>>>
#
# - Row icon. A grouping is the tag's own text, in English only, since no
#   phrase names it; one named Album is told from the Music menu's by %Lk.
#   Now Playing shows the pause icon while paused.
#   The user's own rows have names no skin knows, so they go by %Lk: 10 a
#   view, 11 a menu.
%Vl(Rows,2,3,24,24,2)
%?La<|%?Lm<%?Lc<%Vf(!ffffff)|%Vf(vivid>85:bdbdbd)>%?if(%Lm,=,m)<×|Ö>|%?if(%vg(shape),=,1)<%?Lc<%Vf(!ffffff)|%Vf(vivid>85:bdbdbd)>%?or(%if(%cs,=,7),%if(%cs,=,13),%if(%cs,=,27),%if(%cs,=,28))<%?if(%LT,=,%Sx(Search))<®|%?if(%LT,=,%Sx(By Type))<ª|%?if(%LT,=,%Sx(Moods))<í|%?if(%LT,=,%Sx(Journeys))<î|%sel(%LI,1,¡,0,¥,2,m,9,Ħ,33,¦,34,§,35,Ę,36,ė,-1,-,¨)>>>>|%?if(%Lk,=,10)<ċ|%?if(%Lk,=,11)<Ċ|%?and(%if(%Lk,=,5),%if(%LT,=,Album))<d|%?if(%LT,=,%Sx(Now Playing))<%?mp<A|A|B|A|A>|%sel(%LT,%Sx([All Tracks]),b,%Sx([Random]),V,%Sx([Shuffle Albums]),H,%Sx([Resume]),T,%Sx([Featured In]),Z,%Sx([Untagged]),¿,%Sx([By album]),d,Single,a,EP,b,Compilation,Ĉ,Mixtape,Ĉ,Live Album,Z,Soundtrack,ĉ,%Sx(Resume Playback),C,%Sx(Continue Reading),A,%Sx(Music),c,%Sx(Album Covers),f,%Sx(Artist Portraits),i,%Sx(Queue),U,%Sx(Playlists),ð,%Sx(Playback Report),z,%Sx(Files),¢,%Sx(Settings),Ç,%Sx(System),Ò,%Sx(Shortcuts),Ó,%Sx(Random Album),V,%Sx(Playback History),µ,%Sx(Shuffle Songs),H,%Sx(Documents),w,%Sx(Images),x,%Sx(Search),®,%Sx(Featured Artists),é,%Sx(Audiobooks),ê,%Sx(Podcasts),Ď,%Sx(All Episodes),Ė,%Sx([Play Unplayed]),A,%Sx([In Progress]),ē,%Sx([Not Started]),đ,%Sx([Finished]),Ē,%Sx(Books),Č,%Sx(Book),ë,%Sx(Author),ì,%Sx(Title),l,%Sx(Album),e,%Sx(Albums),e,%Sx(Artist),g,%Sx(Artists),g,%Sx(Album Artist),h,%Sx(Album Artists),h,%Sx(Genre),j,%Sx(Year),¶,%Sx(Composer),k,%Sx(User Rating),²,%Sx(Recently Added),´,%Sx(First Letter),«,%Sx(Tracks by),ª,%Sx(Search by...),¯,%sel(%LT,%Sx(Same as currently played track),Ø,%Sx(By Title),%sel(%cs,38,č,ë),%Sx(By Author),ì,%Sx(By Subject),l,%Sx(Sound Settings),Y,%Sx(Playback Settings),W,%Sx(Library),v,%Sx(Appearance),Ê,%Sx(Battery & Power),Á,%Sx(Settings Mode),Í,%Sx(Changed Settings),É,%Sx(In Progress),ē,%Sx(Not Started),đ,%Sx(Finished),Ē,%Sx(Reading Stats),Ĕ,%Sx(Listening Stats),Ĕ,%Sx(By Series),ģ,%Sx(By Show),ď,%Sx(Quiz),ï,%Sx(About),»,%Sx(System Info),ñ,%Sx(Credits),ò,%Sx(Background Tasks),ó,%Sx(License),ô,%Sx(Debug),õ,%Sx(Custom menu),Ċ,%Sx(Arcade),Ĥ,%Sx(High Scores),Ĕ,%sel(%LI,19,Þ,2,m,9,ĥ)))>>>>>>>>
#
# - Row number
%Vl(Rows,0,5,30,20,3)
%?if(%vg(shape),=,2)<%ac%?Lc<%Vf(!ffffff)|%Vf(vivid>85:bdbdbd)>%Lp>
#
# - Selection bar
%Vl(Rows,36,0,3,30,-)
%?La<|%?if(%vg(shape),!=,3)<%?Lc<%dr(0,0,3,30,vivid>60:ffffff,-,14,3)>>>
%Vl(Rows,2,0,3,30,-)
%?La<|%?if(%vg(shape),=,3)<%?Lc<%dr(0,0,3,30,vivid>60:ffffff,-,14,3)>>>
#
# - Row text, the full width where there is no chevron, switch or slider, and
#   short of it where there is: the switch and slider are inked to the edge of
#   their cell, so the text stops 8px before it. Only one of each pair draws a
#   given row, so neither clears the other's text
%Vl(Rows,46,5,250,20,-)
%?La<|%?and(%if(%vg(shape),!=,3),%if(%vg(chev),=,1))<%?Lc<%Vf(!ffffff)|%Vf(vivid>85:bdbdbd)>%s%?and(%if(%cs,=,1),%if(%LT,=,%Sx(Now Playing)))<%LT: %?it<%it|%fn>|%?or(%if(%Lk,=,5),%if(%LT,=,%Sx([Untagged])))<%trm(%LT,[])|%LT>>>>
%Vl(Rows,46,5,219,20,-)
%?La<|%?and(%if(%vg(shape),!=,3),%if(%vg(chev),!=,1))<%?Lc<%Vf(!ffffff)|%Vf(vivid>85:bdbdbd)>%s%?and(%if(%cs,=,1),%if(%LT,=,%Sx(Now Playing)))<%LT: %?it<%it|%fn>|%?or(%if(%Lk,=,5),%if(%LT,=,%Sx([Untagged])))<%trm(%LT,[])|%LT>>>>
%Vl(Rows,12,5,284,20,-)
%?La<|%?and(%if(%vg(shape),=,3),%if(%vg(chev),=,1))<%?Lc<%Vf(!ffffff)|%Vf(vivid>85:bdbdbd)>%s%?or(%if(%Lk,=,5),%if(%LT,=,%Sx([Untagged])))<%trm(%LT,[])|%LT>>>
%Vl(Rows,12,5,253,20,-)
%?La<|%?and(%if(%vg(shape),=,3),%if(%vg(chev),!=,1))<%?Lc<%Vf(!ffffff)|%Vf(vivid>85:bdbdbd)>%s%?or(%if(%Lk,=,5),%if(%LT,=,%Sx([Untagged])))<%trm(%LT,[])|%LT>>>
#
# - Chevron, switch, slider or value icon. The slider's ten frames are
#   empty only at the least of a range and full only at the greatest, with the
#   eight between split evenly across the rest; a word scale takes the frames
#   %Lr would give it.
%Vl(Rows,272,3,24,24,2)
%?La<|%?if(%vg(chev),!=,1)<%?Lc<%Vf(!ffffff)|%Vf(vivid>85:bdbdbd)>%?if(%vg(chev),=,2)<Þ|%?if(%vg(chev),=,3)<%?if(%Lv,=,%Sx(Yes))<ö|÷>|%?if(%vg(chev),=,4)<%sel(%Lr,0,ø,100,ā,%sel(%ma(%ma(%Lr,*,8),/,100),0,ù,1,ú,2,û,3,ü,4,ý,5,þ,6,ÿ,7,Ā))|%?if(%vg(chev),=,5)<%sel(%Lv,%Sx(Auto),Ă,%Sx(Left),ă,%Sx(Centre),Ą,%Sx(Right),ą,%Sx(Top),Ć,%Sx(Bottom),ć,%Sx(Justified),ĕ)|%?if(%vg(chev),=,6)<%sel(%Lv,%Sx(Off),ø,%Sx(Weak),û,%Sx(Moderate),þ,%Sx(Strong),ā,%Sx(Very Slow),ø,%Sx(Slow),û,%Sx(Normal),ý,%Sx(Fast),ÿ,%Sx(Very Fast),ā,%Sx(Short),ø,%Sx(Medium),ý,%Sx(Long),ā)|%sel(%Lv,%Sx(Off),ø,%Sx(Slow),û,%Sx(Normal),þ,%Sx(Fast),ā)>>>>>>>
#
# Album/Artist row setup
#
# - Special row icon, groupings included; in the Arcade, the
#   cartridge for a game with no logo (%LI 9), which the art below
#   leaves alone: the art line clears the top of the row when drawn.
%Vl(Rows,10,12,24,24,2)
%?La<%?Lc<%Vf(!ffffff)|%Vf(vivid>85:bdbdbd)>%sel(%LT,%Sx([All Tracks]),A,%Sx([Random]),V,%Sx([Shuffle Albums]),H,%Sx([Resume]),T,%Sx([Featured In]),Z,%Sx([Untagged]),¿,%Sx([By album]),d,%Sx(In Progress),ē,%Sx(Not Started),đ,%Sx(Finished),Ē,%Sx(Reading Stats),Ĕ,%Sx(All Episodes),Ė,%Sx([Play Unplayed]),A,%Sx([In Progress]),ē,%Sx([Not Started]),đ,%Sx([Finished]),Ē,%Sx(Search),®,%Sx(By Title),%sel(%cs,38,č,ë),%Sx(By Author),ì,%Sx(By Subject),l,%Sx(High Scores),Ĕ,Single,a,EP,b,Compilation,Ĉ,Mixtape,Ĉ,Live Album,Z,Soundtrack,ĉ,Album,d,%sel(%cs,40,%sel(%LI,9,ĥ)))>
#
# - Row art, darkened by a filter when not selected: a rectangle over
#   the square would darken the sides of a book's narrower cover too.
%Vl(Rows,0,2,44,44,-)
%?and(%La,%if(%Lk,!=,5),%if(%LT,!=,%Sx([Untagged])),%if(%LI,!=,9))<%?or(%if(%cs,=,38),%if(%cs,=,40))<%?Lc<%La|%La(0,-,-,darker40)>|%?Lc<%La(0,-,2)|%La(0,-,2,darker40)>>>
#
# - Selection bar
%Vl(Rows,50,0,3,48,-)
%?and(%La,%Lc)<%dr(0,0,3,48,vivid>60:ffffff,-,14,3)>
#
# - Row text, narrower beside a book's progress gauge. Each line is drawn
#   only when it is the one wanted: an empty line would paint over the other.
%Vl(Rows,60,14,230,20,-)
%?and(%La,%if(%vg(chev),!=,4))<%?Lc<%Vf(!ffffff)|%Vf(vivid>85:bdbdbd)>%s%?or(%if(%Lk,=,5),%if(%LT,=,%Sx([Untagged])))<%trm(%LT,[])|%LT>>
%Vl(Rows,60,14,206,20,-)
%?and(%La,%if(%vg(chev),=,4))<%?Lc<%Vf(!ffffff)|%Vf(vivid>85:bdbdbd)>%s%?or(%if(%Lk,=,5),%if(%LT,=,%Sx([Untagged])))<%trm(%LT,[])|%LT>>
#
# - A book's progress gauge, as the rows without art have it
%Vl(Rows,272,12,24,24,2)
%?La<%?Lr<%?Lc<%Vf(!ffffff)|%Vf(vivid>85:bdbdbd)>%sel(%Lr,0,ø,100,ā,%sel(%ma(%ma(%Lr,*,8),/,100),0,ù,1,ú,2,û,3,ü,4,ý,5,þ,6,ÿ,7,Ā))|>|>
#
# - A show's episodes not started, where a book's gauge would be: a badge
#   in the accent, 1 to 9 and then 9+
%Vl(Rows,272,12,24,24,2)%Vf(vivid>60:ffffff)
%?and(%La,%Lv)<%sel(%Lv,1,ę,2,Ě,3,ě,4,Ĝ,5,ĝ,6,Ğ,7,ğ,8,Ġ,9,ġ,Ģ)>
#
# Quick settings boxes
#
# - Left
%Vl(QuickL,20,72,24,24,2)%Vf(!ffffff)
à
%Vl(QuickL,50,75,98,20,3)%Vf(!ffffff)
%s%QL
%Vl(QuickL,20,100,24,24,2)%Vf(!ffffff)
%sel(%QL,%Sx(Shuffle),H,%Sx(Repeat),J,%Sx(Volume),O,%Sx(Brightness),Å,%Sx(Backlight),Ë,%Sx(Equalizer),P,%Sx(Enable EQ),P,%Sx(Bass),R,%Sx(Treble),R,%Sx(Balance),R,%Sx(Stereo Width),R,%Sx(Crossfeed),R,%Sx(Replaygain Type),R,%Sx(Pre-amp),R,%Sx(Show Track Info),©,%sel(%Ql,%Sx(Yes),É,%Sx(No),É,%Sx(On),É,%Sx(Off),É,Í))
%Vl(QuickL,50,103,98,20,-)%Vf(!ffffff)
%s%Ql

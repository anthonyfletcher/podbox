#
#--- Fonts ---#
#
%Fl(2,26-noto-sans-medium.fnt)
%Fl(3,12-noto-sans.fnt)
%Fl(4,24x24_Icons.fnt)
%Fl(5,18-noto-sans-bold.fnt)
#
#--- Images ---#
#
%xl(vbg,volband.bmp,0,0)
%xl(vwf,volfill.bmp,0,0)
#
#--- Background layer ---#
#
# Album art
%V(0,0,-,-,-)%VB%Vf(000000)%Cl(0,-40,320,320,c,c,blur12+scrim+dither,-,blurred)%Cd(blurred)%Cl(105,10,110,110,c,c,-,8,original)%Cd(original)
%dr(0,185,320,85,000000,-,6,10)
#
# Progress tint
%dr(50,198,220,3,!ffffff,-,6)
#
#--- Foreground layer ---#
#
%V(0,0,-,-,-)
#
# Disable the status bar
%wd
#
# Top bar
%?mv(3)<%Vd(Volume)|>
#
# Album panel contents
#
# - Track title
%V(15,125,290,28,2)
%s%ac%it
#
# - Album
%Vf(ffffff)%V(15,155,290,20,-)
%s%ac%id
#
# Progress
%Vf(ffffff)%V(50,198,220,3,-)%pb(0,0,-,-,noborder)
#
# - Elapsed time
%V(15,193,30,14,3)
%al%pc
# - Remaining time
%V(275,193,30,14,3)
%ar%pr
#
# Status icons
%V(148,210,24,24,4)%Vf(c4c4c4)
%?mp<%Vf(ffffff)C|%Vf(ffffff)A|%Vf(ffffff)B|A|A>
%V(114,210,24,24,4)%Vf(c4c4c4)
%?mp<F|F|F|F|%Vf(ffffff)F>
%V(182,210,24,24,4)%Vf(c4c4c4)
%?mp<G|G|G|%Vf(ffffff)G|G>
%V(80,210,24,24,4)%Vf(c4c4c4)
%?mm<J|%Vf(ffffff)J|%Vf(ffffff)J|%Vf(ffffff)J|%Vf(ffffff)J>
%V(216,210,24,24,4)%Vf(c4c4c4)
%?ps<%Vf(ffffff)H|H>
#
# Volume overlay
%Vl(Volume,0,0,320,35,5)%Vg(000000,000000,ffffff)
%Vs(gradient) 
%Vs(gradient) 
%Vs(gradient) 
%Vl(Volume,8,6,304,24,4)%Vg(000000,000000,ffffff)%Vf(ffffff)
%Vs(gradient)%?pv<M|N|N>%arO
%Vl(Volume,40,15,240,6,-)%Vf(!ffffff)
%dr(0,0,240,6,000000)%pv(0,0,240,6,image,vwf,backdrop,vbg)
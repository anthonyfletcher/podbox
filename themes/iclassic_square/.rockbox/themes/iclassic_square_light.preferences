#
# Which parts take the album's colour. yes takes it, no keeps them
# black. Reload the theme after changing any of them.
#
#-- Progress bar --#
# The bar under the cover on the playing screen.
# Possible Values: yes, no
vivid_progress_bar: yes
#
#-- Volume icons --#
# The speaker icons either side of the volume bar.
# Possible Values: yes, no
vivid_volume_icons: yes
#
#-- Volume bar --#
# The bar shown in place of the progress bar while the volume changes.
# Possible Values: yes, no
vivid_volume_bar: yes
#
#-- Transport icon --#
# The play, pause, fast-forward, rewind and hold icon in the title bar.
# Possible Values: yes, no
vivid_transport_icon: no
#
#-- Title bar --#
# The bar along the top of the screen. no keeps it grey.
# Possible Values: yes, no
vivid_title_bar: no
#
#-- Title text --#
# The text in the title bar: the list's name, or Now Playing.
# Possible Values: yes, no
vivid_title_text: no
#
#-- Song text --#
# The song's title, on the playing screen and in the pane beside lists.
# Possible Values: yes, no
vivid_song_text: no
#
#-- Selection --#
# The bar behind the selected row in lists. no makes it black.
# Possible Values: yes, no
vivid_selection: yes
#
#-- Menu cover --#
# The album cover beside the menus. full fills the right half of the
# screen, as the iPod does; framed shows it smaller, with the song
# playing under it.
# Possible Values: full, framed
menu_cover: full
#
#-- Album header --#
# The cover, name and counts above an album's tracks, a book's chapters
# and a podcast's episodes. off keeps all the list's rows.
# Possible Values: on, off
album_header: on
#
#-- Episode notes --#
# The selected podcast episode's notes in a box below its list. off keeps
# all the list's rows.
# Possible Values: on, off
episode_notes: on
#
#-- Battery number --#
# The charge left as a number beside the battery, in the title bar.
# Possible Values: off, on
battery_number: off

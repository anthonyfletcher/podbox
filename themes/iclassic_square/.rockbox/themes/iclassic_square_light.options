# iClassic Square Light's options, shown in Appearance > Theme Options.
format = 1
title  = iClassic Square Light
help   = Which parts take the album's colour, and which keep the theme's own.

[vivid_progress_bar]
name    = Progress Bar
help    = The bar under the cover on the playing screen.
type    = choice
choice  = yes | Album Colour
choice  = no  | Black
default = yes

[vivid_volume_icons]
name    = Volume Icons
help    = The speaker icons either side of the volume bar.
type    = choice
choice  = yes | Album Colour
choice  = no  | Black
default = yes

[vivid_volume_bar]
name    = Volume Bar
help    = The bar shown in place of the progress bar while the volume changes.
type    = choice
choice  = yes | Album Colour
choice  = no  | Black
default = yes

[vivid_transport_icon]
name    = Transport Icon
help    = The play, pause, fast-forward, rewind and hold icon in the title bar.
type    = choice
choice  = yes | Album Colour
choice  = no  | Black
default = no

[vivid_title_bar]
name    = Title Bar
help    = The bar along the top of the screen.
type    = choice
choice  = yes | Album Colour
choice  = no  | Grey
default = no

[vivid_title_text]
name    = Title Text
help    = The text in the title bar: the list's name, or Now Playing.
type    = choice
choice  = yes | Album Colour
choice  = no  | Black
default = no

[vivid_song_text]
name    = Song Text
help    = The song's title, on the playing screen and in the pane beside lists.
type    = choice
choice  = yes | Album Colour
choice  = no  | Black
default = no

[vivid_selection]
name    = Selection
help    = The bar behind the selected row in lists.
type    = choice
choice  = yes | Album Colour
choice  = no  | Black
default = yes

[menu_cover]
name    = Menu Cover
help    = The album cover beside the menus. Full fills the right half of the
help    = screen, as the iPod does; Framed shows it smaller, with the song
help    = playing under it.
type    = choice
choice  = full   | Full
choice  = framed | Framed
default = full

[album_header]
name    = Album Header
help    = The cover, name and counts above an album's tracks, a book's
help    = chapters and a podcast's episodes, which then show fewer rows. Off,
help    = the lists keep all their rows.
type    = choice
choice  = on  | On
choice  = off | Off
default = on

[episode_notes]
name    = Episode Notes
help    = The selected podcast episode's notes in a box below its list, which
help    = is shorter for it. Off, the lists keep all their rows.
type    = choice
choice  = on  | On
choice  = off | Off
default = on

[battery_number]
name    = Battery Number
help    = The charge left as a number beside the battery, in the title bar.
help    = On, the title between them is narrower to make room.
type    = choice
choice  = off | Off
choice  = on  | On
default = off

[info_1]
name    = Now Playing Row 1
help    = The first row under the song's title on the playing screen, in
help    = bold. Nothing leaves the row empty.
type    = choice
choice  = none         | Nothing
choice  = artist       | Artist
choice  = album_artist | Album Artist
choice  = album        | Album
choice  = composer     | Composer
choice  = genre        | Genre
choice  = year         | Year
choice  = track        | Disc and Track
choice  = position     | Place in Playlist
choice  = format       | Format and Sample Rate
choice  = bitrate      | Bitrate
choice  = rating       | Rating
choice  = plays        | Play Count
choice  = next         | Next Song
choice  = comment      | Comment
default = artist


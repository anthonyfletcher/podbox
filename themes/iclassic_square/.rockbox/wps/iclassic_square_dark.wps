#-----------------------------------------------#
#iclassic_square_dark
#(CC-BY-SA 3.0) by Humberto Santana
#CC BY-SA 3.0
#-----------------------------------------------#
#
#Colours: vivid is the album's most colourful colour, and
#iClassic blue (186dbd, toned to suit) with none. Bars take
#it at tone 40 or lighter and icons and text at 50, so both
#read on black; vivid>40.75 is the bars' lower, darker half.
#The title bar takes it at 40 or darker, so white text reads
#on it. Every other colour is pinned with !. Each word
#carries the blue as its fallback, already at its tone.
#
#Which parts take vivid is set in
#themes/iclassic_square_dark.preferences, read at load. An
#entry that is missing reads as its default: the tests for a
#yes default ask for no, and those for a no ask for yes.
#
#Status bar off
%wd
#
#Preload fonts
%Fl(2,24x24-icons.fnt)
%Fl(3,18-noto-sans-bold.fnt)
%Fl(4,16-noto-sans-bold.fnt)
%Fl(5,16-noto-sans.fnt)
%Fl(6,19-iclassic-icons.fnt)
%Fl(7,14-noto-sans.fnt)
#
#Battery: a frame per charge level, and the same while charging
%xl(battery,battery.bmp,0,4,8)
%xl(charging,battery_charging.bmp,0,4,8)
#
#Background layer
#
#- Title bar
%V(0,0,-,-,-)%VB%Vb(!000000)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_title_bar:),=,yes)<%dr(0,0,320,19,vivid<40:0056a5,vivid<40.50:002b52)|%dr(0,0,320,19,!4a4a4a,!161616)>
%dr(0,19,320,1,!505050)
#
#- Progress track, glass: a light upper half over a darker lower one.
#  Here, not %Vb: %pb clears to the backdrop. 199 wide, as a
#  two-colour %dr draws one column past its width
%dr(60,214,199,6,!3a3a3a,!2a2a2a)
%dr(60,220,199,6,!161616,!202020)
#- Its reflection
%dr(60,226,200,1,!0c0c0c)
%dr(60,227,200,1,!0b0b0b)
%dr(60,228,200,1,!090909)
%dr(60,229,200,1,!080808)
%dr(60,230,200,1,!060606)
%dr(60,231,200,1,!050505)
%dr(60,232,200,1,!030303)
%dr(60,233,200,1,!020202)
#
#Foreground layer
#
#- Volume or progress, the title bar, and each row's text or stars. 1x1
#  because a flip clears its line
%V(319,239,1,1,-)
%?mv(2)<%Vd(Volume)|%Vd(Progress)>%?if(%ft(themes/iclassic_square_dark.preferences,battery_number:),=,on)<%Vd(BarN)|%Vd(BarW)>%?if(%ft(themes/iclassic_square_dark.preferences,info_1:),=,rating)<%Vd(Stars1)|%Vd(Info1)>%?if(%ft(themes/iclassic_square_dark.preferences,info_2:),=,rating)<%Vd(Stars2)|%Vd(Info2)>%?if(%ft(themes/iclassic_square_dark.preferences,info_3:),=,rating)<%Vd(Stars3)|%Vd(Info3)>%?if(%ft(themes/iclassic_square_dark.preferences,info_4:),=,rating)<%Vd(Stars4)|%Vd(Info4)>%?if(%ft(themes/iclassic_square_dark.preferences,info_5:),=,rating)<%Vd(Stars5)|%Vd(Info5)>%?if(%ft(themes/iclassic_square_dark.preferences,info_6:),=,rating)<%Vd(Stars6)|%Vd(Info6)>
#
#- Play state, on the left as on the iPod
%V(4,0,48,19,6)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_transport_icon:),=,yes)<%Vf(vivid>50:2e7cc6)|>%?mh<À|%?mp<|A|B|G|F>>
#
#- Title, centred. BarW without the battery's number, BarN with it
%Vl(BarW,100,1,120,17,4)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_title_text:),=,yes)<%Vf(vivid>50:2e7cc6)|>%ac%Sx(Now Playing)
%Vl(BarN,100,1,102,17,4)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_title_text:),=,yes)<%Vf(vivid>50:2e7cc6)|>%ac%Sx(Now Playing)
#
#- Shuffle, repeat and the busy spinner
%Vl(BarW,222,0,68,19,6)%Vf(!ffffff)
%ar%?ps<I|>%?mm<|K|L|H|K>%?or(%lh,%lb,%lw)<%?la<á|â|ã|ä|å|æ|ç|è>|>
%Vl(BarN,204,0,52,19,6)%Vf(!ffffff)
%ar%?ps<I|>%?mm<|K|L|H|K>%?or(%lh,%lb,%lw)<%?la<á|â|ã|ä|å|æ|ç|è>|>
#
#- The battery's number, "100%" wide, against the battery
%Vl(BarN,256,3,34,15,7)%Vf(!ffffff)
%ar%bl%%
#
#- Battery
%V(292,0,26,19,-)
%?bc<%xd(charging,%bl)|%xd(battery,%bl)>
#
#- Cover or grey tile. Same size and height as the .sbs framed cover, so it
#  holds still between the screens. Not in %VB, which nothing here copies
#  to screen once the art arrives
%V(8,26,150,150,2)%Vy%Vg(!3a3a3a,!202020,!909090)
%?C<|%ac%Vs(gradient)b>
%Cl(0,0,150,150,c,c)%Cd
#
#- Its reflection, fading into the page
%V(8,176,150,24,-)
%Cd(-,-,-,-,-,reflect,35)
#
#Track
#
#- Title
%V(170,30,146,22,3)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_song_text:),=,yes)<%Vf(vivid>50:2e7cc6)|>%s%?it<%it|%fn>
#- Six rows under it, each showing what its theme option names. A
#  row shows text or the rating, two viewports in one place, so the
#  switch above shows one of them
%Vl(Info1,170,54,146,20,4)%Vf(!909090)
%s%?if(%ft(themes/iclassic_square_dark.preferences,info_1:),=,artist)<%?ia<%ia|%?d(2)<%d(2)|>>|%?if(%ft(themes/iclassic_square_dark.preferences,info_1:),=,album_artist)<%?iA<%iA|%ia>|%?if(%ft(themes/iclassic_square_dark.preferences,info_1:),=,album)<%?id<%id|%?d(1)<%d(1)|>>|%?if(%ft(themes/iclassic_square_dark.preferences,info_1:),=,composer)<%ic|%?if(%ft(themes/iclassic_square_dark.preferences,info_1:),=,genre)<%ig|%?if(%ft(themes/iclassic_square_dark.preferences,info_1:),=,year)<%iy|%?if(%ft(themes/iclassic_square_dark.preferences,info_1:),=,track)<%?in<%?ik<%Sx(Disc) %ik · |>%Sx(Track) %in|>|%?if(%ft(themes/iclassic_square_dark.preferences,info_1:),=,position)<%pp %Sx(of) %pe|%?if(%ft(themes/iclassic_square_dark.preferences,info_1:),=,format)<%fc · %fk kHz|%?if(%ft(themes/iclassic_square_dark.preferences,info_1:),=,bitrate)<%fb kbps%?fv< VBR|>|%?if(%ft(themes/iclassic_square_dark.preferences,info_1:),=,plays)<%rp %Sx(Plays)|%?if(%ft(themes/iclassic_square_dark.preferences,info_1:),=,next)<%?Fn<%Sx(Next:) %?It<%It|%Fn>|>|%?if(%ft(themes/iclassic_square_dark.preferences,info_1:),=,comment)<%iC|>>>>>>>>>>>>>
%Vl(Stars1,170,54,146,20,6)%Vf(!909090)
%sel(%rr,1,±°°°°,2,²°°°°,3,²±°°°,4,²²°°°,5,²²±°°,6,²²²°°,7,²²²±°,8,²²²²°,9,²²²²±,10,²²²²²)
%Vl(Info2,170,74,146,20,5)%Vf(!909090)
%s%?if(%ft(themes/iclassic_square_dark.preferences,info_2:),=,artist)<%?ia<%ia|%?d(2)<%d(2)|>>|%?if(%ft(themes/iclassic_square_dark.preferences,info_2:),=,album_artist)<%?iA<%iA|%ia>|%?if(%ft(themes/iclassic_square_dark.preferences,info_2:),=,album)<%?id<%id|%?d(1)<%d(1)|>>|%?if(%ft(themes/iclassic_square_dark.preferences,info_2:),=,composer)<%ic|%?if(%ft(themes/iclassic_square_dark.preferences,info_2:),=,genre)<%ig|%?if(%ft(themes/iclassic_square_dark.preferences,info_2:),=,year)<%iy|%?if(%ft(themes/iclassic_square_dark.preferences,info_2:),=,track)<%?in<%?ik<%Sx(Disc) %ik · |>%Sx(Track) %in|>|%?if(%ft(themes/iclassic_square_dark.preferences,info_2:),=,position)<%pp %Sx(of) %pe|%?if(%ft(themes/iclassic_square_dark.preferences,info_2:),=,format)<%fc · %fk kHz|%?if(%ft(themes/iclassic_square_dark.preferences,info_2:),=,bitrate)<%fb kbps%?fv< VBR|>|%?if(%ft(themes/iclassic_square_dark.preferences,info_2:),=,plays)<%rp %Sx(Plays)|%?if(%ft(themes/iclassic_square_dark.preferences,info_2:),=,next)<%?Fn<%Sx(Next:) %?It<%It|%Fn>|>|%?if(%ft(themes/iclassic_square_dark.preferences,info_2:),=,comment)<%iC|>>>>>>>>>>>>>

#-----------------------------------------------#
#iclassic_square_dark
#(CC-BY-SA 3.0) by Humberto Santana
#CC BY-SA 3.0
#-----------------------------------------------#
#
#Colours: vivid is the album's most colourful colour, and
#iClassic blue (186dbd, toned to suit) with none. Bars take
#it at tone 40 or lighter and icons and text at 50, so both
#read on black; vivid>40.75 is the bars' lower, darker half.
#The title bar takes it at 40 or darker, so white text reads
#on it. Every other colour is pinned with !. Each word
#carries the blue as its fallback, already at its tone.
#
#Which parts take vivid is set in
#themes/iclassic_square_dark.preferences, read at load. An
#entry that is missing reads as its default: the tests for a
#yes default ask for no, and those for a no ask for yes.
#
#Status bar off
%wd
#
#Preload fonts
%Fl(2,24x24-icons.fnt)
%Fl(3,18-noto-sans-bold.fnt)
%Fl(4,16-noto-sans-bold.fnt)
%Fl(5,16-noto-sans.fnt)
%Fl(6,19-iclassic-icons.fnt)
#
#Battery: a frame per charge level, and the same while charging
%xl(battery,battery.bmp,0,4,8)
%xl(charging,battery_charging.bmp,0,4,8)
#
#Background layer
#
#- Title bar
%V(0,0,-,-,-)%VB%Vb(!000000)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_title_bar:),=,yes)<%dr(0,0,320,19,vivid<40:0056a5,vivid<40.50:002b52)|%dr(0,0,320,19,!4a4a4a,!161616)>
%dr(0,19,320,1,!505050)
#
#- Progress track, glass: a light upper half over a darker lower one.
#  Here, not %Vb: %pb clears to the backdrop
%dr(60,214,200,6,!3a3a3a,!2a2a2a)
%dr(60,220,200,6,!161616,!202020)
#
#Foreground layer
#
#- Volume or progress. 1x1 because a flip clears its line
%V(319,239,1,1,-)
%?mv(2)<%Vd(Volume)|%Vd(Progress)>
#
#- Play state, on the left as on the iPod
%V(4,0,48,19,6)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_transport_icon:),=,yes)<%Vf(vivid>50:2e7cc6)|>%?mh<À|%?mp<|A|B|G|F>>
#
#- Title, centred
%V(100,1,120,17,4)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_title_text:),=,yes)<%Vf(vivid>50:2e7cc6)|>%ac%Sx(Now Playing)
#
#- Shuffle, repeat and the busy spinner
%V(222,0,68,19,6)%Vf(!ffffff)
%ar%?ps<I|>%?mm<|K|L|H|K>%?or(%lh,%lb,%lw)<%?la<á|â|ã|ä|å|æ|ç|è>|>
#
#- Battery
%V(292,0,26,19,-)
%?bc<%xd(charging,%bl)|%xd(battery,%bl)>
#
#- Cover or grey tile. Same size as the .sbs cover. Not in %VB, which
#  nothing here copies to screen once the art arrives
%V(8,32,150,150,2)%Vy%Vg(!3a3a3a,!202020,!909090)
%?C<|%ac%Vs(gradient)b>
%Cl(0,0,150,150,c,c)%Cd
#
#- Its reflection, fading into the page
%V(8,182,150,24,-)
%Cd(-,-,-,-,-,reflect,35)
#
#Track
#
#- Title, artist, album
%V(170,36,146,22,3)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_song_text:),=,yes)<%Vf(vivid>50:2e7cc6)|>%s%?it<%it|%fn>
%V(170,60,146,20,4)%Vf(!909090)
%s%?ia<%ia|%?d(2)<%d(2)|>>
%V(170,80,146,20,5)%Vf(!909090)
%s%?id<%id|%?d(1)<%d(1)|>>
#
#- Rating
%V(170,102,146,24,2)%Vf(!909090)
%sel(%rr,1,±°°°°,2,²°°°°,3,²±°°°,4,²²°°°,5,²²±°°,6,²²²°°,7,²²²±°,8,²²²²°,9,²²²²±,10,²²²²²)
#
#- Playlist position
%V(170,128,146,20,5)%Vf(!909090)
%pp %Sx(of) %pe
#
#Progress, glass
%Vl(Progress,2,212,52,20,4)%Vf(!ffffff)
%ar%pc
%Vl(Progress,60,214,200,2,-)%Vf(vivid>60:76aef0)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_progress_bar:),=,no)<%Vf(!ffffff)|>%pb(0,0,-,-,noborder)
%Vl(Progress,60,216,200,4,-)%Vf(vivid>40:186dbd)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_progress_bar:),=,no)<%Vf(!e6e6e6)|>%pb(0,0,-,-,noborder)
%Vl(Progress,60,220,200,4,-)%Vf(vivid>40.75:12528e)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_progress_bar:),=,no)<%Vf(!bfbfbf)|>%pb(0,0,-,-,noborder)
%Vl(Progress,60,224,200,2,-)%Vf(vivid>40.90:1662aa)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_progress_bar:),=,no)<%Vf(!cfcfcf)|>%pb(0,0,-,-,noborder)
%Vl(Progress,266,212,52,20,4)%Vf(!ffffff)
%al-%pr
#
#Volume
%Vl(Volume,32,208,24,24,2)%Vf(vivid>50:2e7cc6)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_volume_icons:),=,no)<%Vf(!ffffff)|>N
%Vl(Volume,60,214,200,2,-)%Vf(vivid>60:76aef0)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_volume_bar:),=,no)<%Vf(!ffffff)|>%pv(0,0,-,-,noborder)
%Vl(Volume,60,216,200,4,-)%Vf(vivid>40:186dbd)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_volume_bar:),=,no)<%Vf(!e6e6e6)|>%pv(0,0,-,-,noborder)
%Vl(Volume,60,220,200,4,-)%Vf(vivid>40.75:12528e)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_volume_bar:),=,no)<%Vf(!bfbfbf)|>%pv(0,0,-,-,noborder)
%Vl(Volume,60,224,200,2,-)%Vf(vivid>40.90:1662aa)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_volume_bar:),=,no)<%Vf(!cfcfcf)|>%pv(0,0,-,-,noborder)
%Vl(Volume,264,208,24,24,2)%Vf(vivid>50:2e7cc6)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_volume_icons:),=,no)<%Vf(!ffffff)|>O

#-----------------------------------------------#
#iclassic_square_light
#(CC-BY-SA 3.0) by Humberto Santana
#CC BY-SA 3.0
#-----------------------------------------------#
#
#Colours: vivid is the album's most colourful colour, and
#iClassic blue (186dbd, toned to suit) with none. Bars take
#it at tone 60 or darker and icons and text at 50, so both
#read on white; vivid<60.75 is the bars' lower, darker half.
#The title bar takes it at 60 or lighter, so black text reads
#on it. Every other colour is pinned with !. Each word
#carries the blue as its fallback, already at its tone.
#
#Which parts take vivid is set in
#themes/iclassic_square_light.preferences, read at load. An
#entry that is missing reads as its default: the tests for a
#yes default ask for no, and those for a no ask for yes.
#
#Status bar off
%wd
#
#Preload fonts
%Fl(2,24x24-icons.fnt)
%Fl(3,18-noto-sans-bold.fnt)
%Fl(4,16-noto-sans-bold.fnt)
%Fl(5,16-noto-sans.fnt)
%Fl(6,19-iclassic-icons.fnt)
%Fl(7,14-noto-sans.fnt)
#
#Battery: a frame per charge level, and the same while charging
%xl(battery,battery.bmp,0,4,8)
%xl(charging,battery_charging.bmp,0,4,8)
#
#Background layer
#
#- Title bar
%V(0,0,-,-,-)%VB%Vb(!ffffff)%Vf(!000000)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_title_bar:),=,yes)<%dr(0,0,320,19,vivid>60:4d96e1,vivid>60.85:4180bf)|%dr(0,0,320,19,!ebebeb,!d3d3d3)>
%dr(0,19,320,1,!afafaf)
#
#- Progress track, glass: a light upper half over a darker lower one.
#  Here, not %Vb: %pb clears to the backdrop
%dr(60,214,200,6,!f4f4f4,!e0e0e0)
%dr(60,220,200,6,!c8c8c8,!d8d8d8)
#
#Foreground layer
#
#- Volume or progress. 1x1 because a flip clears its line
%V(319,239,1,1,-)
%?mv(2)<%Vd(Volume)|%Vd(Progress)>%?if(%ft(themes/iclassic_square_light.preferences,battery_number:),=,on)<%Vd(BarN)|%Vd(BarW)>
#
#- Play state, on the left as on the iPod
%V(4,0,48,19,6)%Vf(!000000)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_transport_icon:),=,yes)<%Vf(vivid<50:186dbd)|>%?mh<À|%?mp<|A|B|G|F>>
#
#- Title, centred. BarW without the battery's number, BarN with it
%Vl(BarW,100,1,120,17,4)%Vf(!000000)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_title_text:),=,yes)<%Vf(vivid<50:186dbd)|>%ac%Sx(Now Playing)
%Vl(BarN,100,1,102,17,4)%Vf(!000000)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_title_text:),=,yes)<%Vf(vivid<50:186dbd)|>%ac%Sx(Now Playing)
#
#- Shuffle, repeat and the busy spinner
%Vl(BarW,222,0,68,19,6)%Vf(!000000)
%ar%?ps<I|>%?mm<|K|L|H|K>%?or(%lh,%lb,%lw)<%?la<á|â|ã|ä|å|æ|ç|è>|>
%Vl(BarN,204,0,52,19,6)%Vf(!000000)
%ar%?ps<I|>%?mm<|K|L|H|K>%?or(%lh,%lb,%lw)<%?la<á|â|ã|ä|å|æ|ç|è>|>
#
#- The battery's number, "100%" wide, against the battery
%Vl(BarN,256,3,34,15,7)%Vf(!000000)
%ar%bl%%
#
#- Battery
%V(292,0,26,19,-)
%?bc<%xd(charging,%bl)|%xd(battery,%bl)>
#
#- Cover or grey tile. Same size as the .sbs cover. Not in %VB, which
#  nothing here copies to screen once the art arrives
%V(8,32,150,150,2)%Vy%Vg(!c5c5c5,!dfdfdf,!6f6f6f)
%?C<|%ac%Vs(gradient)b>
%Cl(0,0,150,150,c,c)%Cd
#
#- Its reflection, fading into the page
%V(8,182,150,24,-)
%Cd(-,-,-,-,-,reflect,35)
#
#Track
#
#- Title, artist, album
%V(170,36,146,22,3)%Vf(!000000)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_song_text:),=,yes)<%Vf(vivid<50:186dbd)|>%s%?it<%it|%fn>
%V(170,60,146,20,4)%Vf(!6f6f6f)
%s%?ia<%ia|%?d(2)<%d(2)|>>
%V(170,80,146,20,5)%Vf(!6f6f6f)
%s%?id<%id|%?d(1)<%d(1)|>>
#
#- Rating
%V(170,102,146,24,2)%Vf(!6f6f6f)
%sel(%rr,1,±°°°°,2,²°°°°,3,²±°°°,4,²²°°°,5,²²±°°,6,²²²°°,7,²²²±°,8,²²²²°,9,²²²²±,10,²²²²²)
#
#- Playlist position
%V(170,128,146,20,5)%Vf(!6f6f6f)
%pp %Sx(of) %pe
#
#Progress, glass
%Vl(Progress,2,212,52,20,4)%Vf(!000000)
%ar%pc
%Vl(Progress,60,214,200,2,-)%Vf(vivid>70:8cc4f8)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_progress_bar:),=,no)<%Vf(!707070)|>%pb(0,0,-,-,noborder)
%Vl(Progress,60,216,200,4,-)%Vf(vivid<60:186dbd)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_progress_bar:),=,no)<%Vf(!202020)|>%pb(0,0,-,-,noborder)
%Vl(Progress,60,220,200,4,-)%Vf(vivid<60.75:12528e)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_progress_bar:),=,no)<%Vf(!000000)|>%pb(0,0,-,-,noborder)
%Vl(Progress,60,224,200,2,-)%Vf(vivid<60.90:1662aa)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_progress_bar:),=,no)<%Vf(!181818)|>%pb(0,0,-,-,noborder)
%Vl(Progress,266,212,52,20,4)%Vf(!000000)
%al-%pr
#
#Volume
%Vl(Volume,32,208,24,24,2)%Vf(vivid<50:186dbd)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_volume_icons:),=,no)<%Vf(!000000)|>N
%Vl(Volume,60,214,200,2,-)%Vf(vivid>70:8cc4f8)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_volume_bar:),=,no)<%Vf(!707070)|>%pv(0,0,-,-,noborder)
%Vl(Volume,60,216,200,4,-)%Vf(vivid<60:186dbd)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_volume_bar:),=,no)<%Vf(!202020)|>%pv(0,0,-,-,noborder)
%Vl(Volume,60,220,200,4,-)%Vf(vivid<60.75:12528e)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_volume_bar:),=,no)<%Vf(!000000)|>%pv(0,0,-,-,noborder)
%Vl(Volume,60,224,200,2,-)%Vf(vivid<60.90:1662aa)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_volume_bar:),=,no)<%Vf(!181818)|>%pv(0,0,-,-,noborder)
%Vl(Volume,264,208,24,24,2)%Vf(vivid<50:186dbd)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_volume_icons:),=,no)<%Vf(!000000)|>O

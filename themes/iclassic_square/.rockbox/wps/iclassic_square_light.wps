%Vl(Progress,60,226,200,1,-)%Vf(vivid<60.90~ffffff60:a2c0dd)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_progress_bar:),=,no)<%Vf(!a3a3a3)|>%pb(0,0,-,-,noborder)

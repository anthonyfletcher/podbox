%?if(%ft(themes/iclassic_square_light.preferences,vivid_progress_bar:),=,no)<%Vf(!f3f3f3)|>%pb(0,0,-,-,noborder)
%Vl(Progress,266,212,52,20,4)%Vf(!000000)
%al-%pr
#
#Scrubbing: the track bare, with a diamond where the wheel has got to, as
#Apple's scrubber. Six left of the track and 12 wider, so the diamond's
#centre runs where the bar's end would
%Vl(Scrub,2,212,52,20,4)%Vf(!000000)
%ar%pc
%Vl(Scrub,54,213,212,13,-)%Vf(vivid<60.75:12528e)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_progress_bar:),=,no)<%Vf(!000000)|>%pb(0,0,-,-,nobar,slider,scrubber)
%Vl(Scrub,266,212,52,20,4)%Vf(!000000)
%al-%pr
#
#Volume
%Vl(Volume,32,208,24,24,2)%Vf(vivid<50:186dbd)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_volume_icons:),=,no)<%Vf(!000000)|>N

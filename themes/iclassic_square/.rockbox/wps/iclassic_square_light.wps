#
#Progress, glass
%Vl(Progress,2,212,52,20,4)%Vf(!000000)
%ar%pc
%Vl(Progress,60,214,200,2,-)%Vf(vivid>70:8cc4f8)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_progress_bar:),=,no)<%Vf(!707070)|>%pb(0,0,-,-,noborder)
%Vl(Progress,60,216,200,4,-)%Vf(vivid<60:186dbd)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_progress_bar:),=,no)<%Vf(!202020)|>%pb(0,0,-,-,noborder)
%Vl(Progress,60,220,200,4,-)%Vf(vivid<60.75:12528e)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_progress_bar:),=,no)<%Vf(!000000)|>%pb(0,0,-,-,noborder)
%Vl(Progress,60,224,200,2,-)%Vf(vivid<60.90:1662aa)
%?if(%ft(themes/iclassic_square_light.preferences,vivid_progress_bar:),=,no)<%Vf(!181818)|>%pb(0,0,-,-,noborder)

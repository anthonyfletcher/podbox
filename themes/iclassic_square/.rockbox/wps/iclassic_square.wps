#
#Progress, glass
%Vl(Progress,2,212,52,20,4)%Vf(000000)
%ar%pc
%Vl(Progress,60,214,200,2,-)%Vf(accent>80:a8d4fa)
%pb(0,0,-,-,noborder)
%Vl(Progress,60,216,200,4,-)%Vf(accent>60:5ea8f0)
%pb(0,0,-,-,noborder)
%Vl(Progress,60,220,200,4,-)%Vf(accent>60.75:2a7fd6)
%pb(0,0,-,-,noborder)
%Vl(Progress,60,224,200,2,-)%Vf(accent>60.90:4a96e4)
%pb(0,0,-,-,noborder)
#- Its reflection, fading into the page
%Vl(Progress,60,226,200,1,-)%Vf(accent>60.90~dominant60:b7d5f4)
%pb(0,0,-,-,noborder)
%Vl(Progress,60,227,200,1,-)%Vf(accent>60.90~dominant65:c0daf6)
%pb(0,0,-,-,noborder)
%Vl(Progress,60,228,200,1,-)%Vf(accent>60.90~dominant70:c9e0f7)
%pb(0,0,-,-,noborder)
%Vl(Progress,60,229,200,1,-)%Vf(accent>60.90~dominant75:d2e5f8)
%pb(0,0,-,-,noborder)
%Vl(Progress,60,230,200,1,-)%Vf(accent>60.90~dominant80:dbeafa)
%pb(0,0,-,-,noborder)
%Vl(Progress,60,231,200,1,-)%Vf(accent>60.90~dominant85:e4effb)
%pb(0,0,-,-,noborder)
%Vl(Progress,60,232,200,1,-)%Vf(accent>60.90~dominant90:edf4fc)
%pb(0,0,-,-,noborder)
%Vl(Progress,60,233,200,1,-)%Vf(accent>60.90~dominant95:f6fafe)
%pb(0,0,-,-,noborder)
%Vl(Progress,266,212,52,20,4)%Vf(000000)
%al-%pr
#
#Scrubbing: the track bare, with a diamond where the wheel has got to, as
#Apple's scrubber. Six left of the track and 12 wider, so the diamond's
#centre runs where the bar's end would
%Vl(Scrub,2,212,52,20,4)%Vf(000000)
%ar%pc
%Vl(Scrub,54,213,212,13,-)%Vf(accent>60.75:2a7fd6)
%pb(0,0,-,-,nobar,slider,scrubber)
%Vl(Scrub,266,212,52,20,4)%Vf(000000)
%al-%pr
#
#Volume
%Vl(Volume,32,208,24,24,2)%Vf(000000)
N

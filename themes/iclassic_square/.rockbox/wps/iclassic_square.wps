#-----------------------------------------------#
#
#Status bar off
%wd
#
#Preload fonts
%Fl(2,24x24-icons.fnt)
%Fl(3,18-noto-sans-bold.fnt)
%Fl(4,16-noto-sans-bold.fnt)
%Fl(5,16-noto-sans.fnt)
%Fl(6,19-iclassic-icons.fnt)
#
#Battery: a frame per charge level, and the same while charging
%xl(battery,battery.bmp,0,4,8)
%xl(charging,battery_charging.bmp,0,4,8)
#
#Background layer
#
#- Title bar
%V(0,0,-,-,-)%VB%Vb(ffffff)%Vf(000000)
%dr(0,0,320,19,e4e4e4,a8a8a8)
%dr(0,19,320,1,707070)
#
#- Progress track, glass: a light upper half over a darker lower one.
#  Here, not %Vb: %pb clears to the backdrop
%dr(60,214,200,6,f4f4f4,e0e0e0)
%dr(60,220,200,6,c8c8c8,d8d8d8)
#
#Foreground layer
#
#- Volume or progress. 1x1 because a flip clears its line
%V(319,239,1,1,-)
%?mv(2)<%Vd(Volume)|%Vd(Progress)>
#
#- Play state, on the left as on the iPod
%V(4,0,48,19,6)%Vf(accent<50:2f7fd6)
%?mh<À|%?mp<|A|B|G|F>>
#
#- Title, centred
%V(100,1,120,17,4)%Vf(000000)
%ac%Sx(Now Playing)
#
#- Shuffle, repeat and the busy spinner
%V(222,0,68,19,6)%Vf(000000)
%ar%?ps<I|>%?mm<|K|L|H|K>%?or(%lh,%lb,%lw)<%?la<á|â|ã|ä|å|æ|ç|è>|>
#
#- Battery
%V(292,0,26,19,-)
%?bc<%xd(charging,%bl)|%xd(battery,%bl)>
#
#- Cover or grey tile. Same size as the .sbs cover. Not in %VB, which
#  nothing here copies to screen once the art arrives
%V(8,32,150,150,2)%Vy%Vg(d8d8d8,a0a0a0,ffffff)
%?C<|%ac%Vs(gradient)b>
%Cl(0,0,150,150,c,c)%Cd
#
#- Its reflection, fading into the page
%V(8,182,150,24,-)
%Cd(-,-,-,-,-,reflect,35)
#
#Track
#
#- Title, artist, album
%V(170,36,146,22,3)%Vf(000000)
%s%?it<%it|%fn>
%V(170,60,146,20,4)%Vf(888888)
%s%?ia<%ia|%?d(2)<%d(2)|>>
%V(170,80,146,20,5)%Vf(888888)
%s%?id<%id|%?d(1)<%d(1)|>>
#
#- Rating
%V(170,102,146,24,2)%Vf(888888)
%sel(%rr,1,±°°°°,2,²°°°°,3,²±°°°,4,²²°°°,5,²²±°°,6,²²²°°,7,²²²±°,8,²²²²°,9,²²²²±,10,²²²²²)
#
#- Playlist position
%V(170,128,146,20,5)%Vf(888888)
%pp %Sx(of) %pe
#
#Progress, glass
%Vl(Progress,2,212,52,20,4)%Vf(000000)
%ar%pc
%Vl(Progress,60,214,200,2,-)%Vf(accent>80:a8d4fa)
%pb(0,0,-,-,noborder)
%Vl(Progress,60,216,200,4,-)%Vf(accent>60:5ea8f0)
%pb(0,0,-,-,noborder)
%Vl(Progress,60,220,200,4,-)%Vf(accent>60.75:2a7fd6)
%pb(0,0,-,-,noborder)
%Vl(Progress,60,224,200,2,-)%Vf(accent>60.90:4a96e4)
%pb(0,0,-,-,noborder)
%Vl(Progress,266,212,52,20,4)%Vf(000000)
%al-%pr
#
#Volume
%Vl(Volume,32,208,24,24,2)%Vf(000000)
N
%Vl(Volume,60,214,200,2,-)%Vf(accent>80:a8d4fa)
%pv(0,0,-,-,noborder)
%Vl(Volume,60,216,200,4,-)%Vf(accent>60:5ea8f0)
%pv(0,0,-,-,noborder)
%Vl(Volume,60,220,200,4,-)%Vf(accent>60.75:2a7fd6)
%pv(0,0,-,-,noborder)
%Vl(Volume,60,224,200,2,-)%Vf(accent>60.90:4a96e4)
%pv(0,0,-,-,noborder)
%Vl(Volume,264,208,24,24,2)%Vf(000000)
O

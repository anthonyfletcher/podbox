%Vl(Info5,170,134,146,20,5)%Vf(888888)
%s%?if(%ft(themes/iclassic_square.preferences,info_5:),=,artist)<%?ia<%ia|%?d(2)<%d(2)|>>|%?if(%ft(themes/iclassic_square.preferences,info_5:),=,album_artist)<%?iA<%iA|%ia>|%?if(%ft(themes/iclassic_square.preferences,info_5:),=,album)<%?id<%id|%?d(1)<%d(1)|>>|%?if(%ft(themes/iclassic_square.preferences,info_5:),=,composer)<%ic|%?if(%ft(themes/iclassic_square.preferences,info_5:),=,genre)<%ig|%?if(%ft(themes/iclassic_square.preferences,info_5:),=,year)<%iy|%?if(%ft(themes/iclassic_square.preferences,info_5:),=,track)<%?in<%?ik<%Sx(Disc) %ik · |>%Sx(Track) %in|>|%?if(%ft(themes/iclassic_square.preferences,info_5:),=,position)<%pp %Sx(of) %pe|%?if(%ft(themes/iclassic_square.preferences,info_5:),=,format)<%fc · %fk kHz|%?if(%ft(themes/iclassic_square.preferences,info_5:),=,bitrate)<%fb kbps%?fv< VBR|>|%?if(%ft(themes/iclassic_square.preferences,info_5:),=,plays)<%rp %Sx(Plays)|%?if(%ft(themes/iclassic_square.preferences,info_5:),=,next)<%?Fn<%Sx(Next:) %?It<%It|%Fn>|>|%?if(%ft(themes/iclassic_square.preferences,info_5:),=,comment)<%iC|>>>>>>>>>>>>>

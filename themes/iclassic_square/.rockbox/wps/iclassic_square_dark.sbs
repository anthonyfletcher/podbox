%Vl(Rows,0,0,48,44,2)%Vy
%?La<%?Lc<%?if(%ft(themes/iclassic_square_dark.preferences,vivid_selection:),=,no)<%Vg(!ffffff,!c8c8c8,!000000)|%Vg(vivid>60:4d96e1,vivid>60.80:3e78b4,!000000)>%Vs(gradient)|%Vf(!ffffff)>%ac%sel(%LT,%Sx([All Tracks]),A,%Sx([Random]),V,%Sx([Shuffle Albums]),H,%Sx([Resume]),T,%Sx([Featured In]),Z,%Sx([Untagged]),¿,%Sx([By album]),d,%Sx(Finished),Ē,%Sx(Not Started),đ,%Sx(In Progress),ē,%Sx(All Episodes),Ė,%Sx([Play Unplayed]),A,%Sx(Search),®,%Sx(High Scores),Ĕ,%sel(%cs,40,%sel(%LI,9,ĥ, ), ))>

#-----------------------------------------------#
#
#Colours: vivid is the album's most colourful colour, and
#iClassic blue (186dbd, toned to suit) with none. Icons and
#text take it at tone 50 or lighter, so they read on black;
#the selection bar at 60 or lighter, so black text reads on
#it; the title bar at 40 or darker, so white text does. Every
#other colour is pinned with !. Each word carries the blue as
#its fallback, already at its tone.
#
#Which parts take vivid is set in
#themes/iclassic_square_dark.preferences, read at load. An
#entry that is missing reads as its default: the tests for a
#yes default ask for no, and those for a no ask for yes.
#
#Status bar off
%wd
#
#Preload fonts
%Fl(2,24x24-icons.fnt)
%Fl(3,18-noto-sans-bold.fnt)
%Fl(4,16-noto-sans-bold.fnt)
%Fl(5,16-noto-sans.fnt)
#
#Background layer
#
#- Title bar and list rule
%V(0,0,-,-,-)%VB%Vb(!000000)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_title_bar:),=,yes)<%dr(0,0,320,23,vivid<40:0056a5,vivid<40.50:002b52)|%dr(0,0,320,23,!2c2c2c,!141414)>
%dr(0,23,320,1,!505050)
%dr(160,24,1,216,!303030)
#
#Foreground layer
#
#- Empty pane: its clear repaints the margins after Cover Flow
%Vl(Pane,160,24,160,216,-)
#
#- Cover or grey tile. Not in %VB, which nothing here copies to screen
%Vl(Pane,166,30,150,150,2)%Vy%Vg(!3a3a3a,!202020,!909090)
%?C<|%ac%Vs(gradient)b>
%Cl(0,0,150,150,c,c)%Cd
#
#- Screen switches. 1x1 because a flip clears its line
%V(319,239,1,1,-)
%Vd(Chrome)
%?mh<%Vd(Status)|%?mp<%Vd(StatusWide)|%Vd(Status)|%Vd(Status)|%Vd(Status)|%Vd(Status)>>
%?if(%cs,=,10)<%Vd(QuickBg)%?if(%QT,!=,ERR)<%Vd(QuickT)>%?if(%QL,!=,ERR)<%Vd(QuickL)>%?if(%QR,!=,ERR)<%Vd(QuickR)>%?if(%QB,!=,ERR)<%Vd(QuickB)>>
%?if(%cs,=,22)<|%Vd(Pane)>
#
#Rows: plain 24, art 46
%Lb(Rows,160,24,-,46)
#
#Set up list
%Vi(list,0,24,160,216,3)%Vb(!000000)%Vf(!ffffff)
#
#- Hidden list for the quick screen
%Vi(qsblank,0,0,1,1,-)
#
%V(318,239,1,1,-)%Vb(!000000)%Vf(!ffffff)%?if(%cs,=,10)<%VI(qsblank)|%VI(list)>
#
#- Title
%Vl(Chrome,6,3,196,19,4)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_title_text:),=,yes)<%Vf(vivid>50:2e7cc6)|>%?if(%cs,=,10)<Quick Settings|%?if(%Lt,=,Rockbox)<iPod|%s%Lt>>
#
#- Status icons, in 24px slots: battery rightmost, then hold or
#  transport, then the rest, which close up when there is no
#  transport icon. Split so the two can take their own colours
%Vl(Status,222,0,48,23,2)%Vf(!ffffff)
%ar%?or(%lh,%lb,%lw)<%?la<á|â|ã|ä|å|æ|ç|è>|>
%Vl(StatusWide,222,0,72,23,2)%Vf(!ffffff)
%ar%?or(%lh,%lb,%lw)<%?la<á|â|ã|ä|å|æ|ç|è>|>
%Vl(Chrome,270,0,24,23,2)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_transport_icon:),=,yes)<%Vf(vivid>50:2e7cc6)|>%?mh<À|%?mp<|A|B|G|F>>
%Vl(Chrome,294,0,24,23,2)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_battery_icon:),=,yes)<%Vf(vivid>50:2e7cc6)|>%?bc<%?bl<·|·|¸|¸|¸|¸|¹|º>|%?bl<1|1|2|3|4|5|6|7>>
#
#- Selected row: a vivid bar with black text, or a white one
#
#- Plain row, the full width where there is no chevron
%Vl(Rows,0,0,160,24,3)%Vy
%?La<|%?and(%or(%if(%cs,!=,6),%if(%Lk,!=,1)),%or(%and(%if(%cs,!=,7),%if(%cs,!=,8),%if(%cs,!=,13),%if(%cs,!=,27),%if(%cs,!=,28)),%if(%Lk,!=,6)),%or(%if(%cs,!=,13),%if(%Lk,!=,8)))<%?Lc<%?if(%ft(themes/iclassic_square_dark.preferences,vivid_selection:),=,no)<%Vg(!ffffff,!ffffff,!000000)|%Vg(vivid>60:4d96e1,vivid>60:4d96e1,!000000)>%Vs(gradient)|%Vf(!ffffff)>%s %sel(%LT,%Sx([All Tracks]),%ss(1,10,%LT),%Sx([Random]),%ss(1,6,%LT),%Sx([Resume]),%ss(1,6,%LT),%Sx([Featured In]),%ss(1,11,%LT),%Sx([Untagged]),%ss(1,8,%LT),%Sx([By album]),%ss(1,8,%LT),%Sx([Finished]),%ss(1,8,%LT),%Sx([Not Started]),%ss(1,11,%LT),%Sx([In Progress]),%ss(1,11,%LT),%LT)>>
#
#- Plain row beside a chevron. Only one of the two draws a
#  given row, so neither clears the other's text
%Vl(Rows,0,0,136,24,3)%Vy
%?La<|%?or(%and(%if(%cs,=,6),%if(%Lk,=,1)),%and(%or(%if(%cs,=,7),%if(%cs,=,8),%if(%cs,=,13),%if(%cs,=,27),%if(%cs,=,28)),%if(%Lk,=,6)),%and(%if(%cs,=,13),%if(%Lk,=,8)))<%?Lc<%?if(%ft(themes/iclassic_square_dark.preferences,vivid_selection:),=,no)<%Vg(!ffffff,!ffffff,!000000)|%Vg(vivid>60:4d96e1,vivid>60:4d96e1,!000000)>%Vs(gradient)|%Vf(!ffffff)>%s %sel(%LT,%Sx([All Tracks]),%ss(1,10,%LT),%Sx([Random]),%ss(1,6,%LT),%Sx([Resume]),%ss(1,6,%LT),%Sx([Featured In]),%ss(1,11,%LT),%Sx([Untagged]),%ss(1,8,%LT),%Sx([By album]),%ss(1,8,%LT),%Sx([Finished]),%ss(1,8,%LT),%Sx([Not Started]),%ss(1,11,%LT),%Sx([In Progress]),%ss(1,11,%LT),%LT)>>
#
#- Plain row chevron
%Vl(Rows,136,0,24,24,2)%Vy
%?La<|%?or(%and(%if(%cs,=,6),%if(%Lk,=,1)),%and(%or(%if(%cs,=,7),%if(%cs,=,8),%if(%cs,=,13),%if(%cs,=,27),%if(%cs,=,28)),%if(%Lk,=,6)),%and(%if(%cs,=,13),%if(%Lk,=,8)))<%?Lc<%?if(%ft(themes/iclassic_square_dark.preferences,vivid_selection:),=,no)<%Vg(!ffffff,!ffffff,!000000)|%Vg(vivid>60:4d96e1,vivid>60:4d96e1,!000000)>%Vs(gradient)|%Vf(!ffffff)>Þ>>
#
#- Art row special icon. Must stay above the cover
%Vl(Rows,10,11,24,24,2)
%?La<%?Lc<%?if(%ft(themes/iclassic_square_dark.preferences,vivid_selection:),=,no)<%Vf(!ffffff)|%Vf(vivid>50:2e7cc6)>|%Vf(!ffffff)>%sel(%LT,%Sx([All Tracks]),A,%Sx([Random]),V,%Sx([Resume]),T,%Sx([Featured In]),Z,%Sx([Untagged]),¿,%Sx([By album]),d,%Sx([Finished]),×,%Sx([Not Started]),Ö,%Sx([In Progress]),q)>
#
#- Art row cover
%Vl(Rows,1,1,44,44,-)
%?and(%La,%if(%LT,!=,%Sx([All Tracks])),%if(%LT,!=,%Sx([Random])),%if(%LT,!=,%Sx([Resume])),%if(%LT,!=,%Sx([Featured In])),%if(%LT,!=,%Sx([Untagged])),%if(%LT,!=,%Sx([By album])),%if(%LT,!=,%Sx([Finished])),%if(%LT,!=,%Sx([Not Started])),%if(%LT,!=,%Sx([In Progress])))<%La>
#
#- Art row text
%Vl(Rows,46,0,114,46,3)%Vy
%?La<%?Lc<%?if(%ft(themes/iclassic_square_dark.preferences,vivid_selection:),=,no)<%Vg(!ffffff,!ffffff,!000000)|%Vg(vivid>60:4d96e1,vivid>60:4d96e1,!000000)>%Vs(gradient)|%Vf(!ffffff)>%s %sel(%LT,%Sx([All Tracks]),%ss(1,10,%LT),%Sx([Random]),%ss(1,6,%LT),%Sx([Resume]),%ss(1,6,%LT),%Sx([Featured In]),%ss(1,11,%LT),%Sx([Untagged]),%ss(1,8,%LT),%Sx([By album]),%ss(1,8,%LT),%Sx([Finished]),%ss(1,8,%LT),%Sx([Not Started]),%ss(1,11,%LT),%Sx([In Progress]),%ss(1,11,%LT),%LT)|>
#
#Now-playing pane
%Vl(Pane,166,184,150,22,3)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_song_text:),=,yes)<%Vf(vivid>50:2e7cc6)|>%s%?it<%it|%fn>
%Vl(Pane,166,206,150,20,4)%Vf(!909090)
%s%?ia<%ia|%?d(2)<%d(2)|>>
#
#Quick screen
#
#- Background
%Vl(QuickBg,0,24,160,216,-)
%dr(0,0,160,216,!000000)
#
#- Up
%Vl(QuickT,4,30,24,24,2)%Vf(vivid>50:2e7cc6)
Ý
%Vl(QuickT,32,30,124,20,4)%Vf(!909090)
%s%QT
%Vl(QuickT,32,50,124,22,3)%Vf(!ffffff)
%s%Qt
#
#- Left
%Vl(QuickL,4,82,24,24,2)%Vf(vivid>50:2e7cc6)
à
%Vl(QuickL,32,82,124,20,4)%Vf(!909090)
%s%QL
%Vl(QuickL,32,102,124,22,3)%Vf(!ffffff)
%s%Ql
#
#- Right
%Vl(QuickR,4,134,24,24,2)%Vf(vivid>50:2e7cc6)
Þ
%Vl(QuickR,32,134,124,20,4)%Vf(!909090)
%s%QR
%Vl(QuickR,32,154,124,22,3)%Vf(!ffffff)
%s%Qr
#
#- Down
%Vl(QuickB,4,186,24,24,2)%Vf(vivid>50:2e7cc6)
ß
%Vl(QuickB,32,186,124,20,4)%Vf(!909090)
%s%QB
%Vl(QuickB,32,206,124,22,3)%Vf(!ffffff)
%s%Qb

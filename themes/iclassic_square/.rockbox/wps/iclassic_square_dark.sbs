#
#An album's header over its tracks, a book's over its chapters and a
#show's over its episodes: the cover, then the name, the artist or
#author, and the year and count
%Vl(AlbumHead,0,20,320,52,-)
%Vl(AlbumHead,4,24,44,44,-)
%LH(art)
%Vl(AlbumHead,56,20,260,17,4)%Vf(!ffffff)
%s%LH(name)

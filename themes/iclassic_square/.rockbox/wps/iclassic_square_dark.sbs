%Vl(Rows,136,0,24,24,6)%Vy
%?La<|%?or(%if(%cs,=,1),%if(%cs,=,6),%if(%cs,=,12),%if(%cs,=,15),%if(%cs,=,16),%if(%cs,=,19),%and(%if(%cs,=,8),%or(%if(%Lt,=,Rockbox),%if(%Lt,=,%Sx(Music)),%if(%Lt,=,%Sx(Audiobooks)),%if(%Lt,=,%Sx(Podcasts)),%if(%Lt,=,%Sx(Custom menu)))),%and(%if(%cs,=,38),%if(%Lt,=,%Sx(Books))))<%?or(%and(%if(%cs,=,6),%if(%Lk,=,1)),%and(%or(%if(%cs,=,7),%if(%cs,=,8),%if(%cs,=,13),%if(%cs,=,27),%if(%cs,=,28)),%if(%Lk,=,6)),%and(%if(%cs,=,13),%if(%Lk,=,8)))<%?Lc<%?if(%ft(themes/iclassic_square_dark.preferences,vivid_selection:),=,no)<%Vg(!ffffff,!c8c8c8,!000000)|%Vg(vivid>60:4d96e1,vivid>60.80:3e78b4,!000000)>%Vs(gradient)Þ|>>|>>

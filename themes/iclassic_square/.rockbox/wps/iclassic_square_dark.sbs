#-----------------------------------------------#
#iclassic_square_dark
#(CC-BY-SA 3.0) by Humberto Santana
#CC BY-SA 3.0
#-----------------------------------------------#
#
#Colours: vivid is the album's most colourful colour, and
#iClassic blue (186dbd, toned to suit) with none. Icons and
#text take it at tone 50 or lighter, so they read on black;
#the selection bar at 60 or lighter, so black text reads on
#it; the title bar at 40 or darker, so white text does. Every
#other colour is pinned with !. Each word carries the blue as
#its fallback, already at its tone.
#
#Which parts take vivid is set in
#themes/iclassic_square_dark.preferences, read at load. An
#entry that is missing reads as its default: the tests for a
#yes default ask for no, and those for a no ask for yes.
#
#Status bar off
%wd
#
#Preload fonts
%Fl(2,24x24-icons.fnt)
%Fl(3,18-noto-sans-bold.fnt)
%Fl(4,16-noto-sans-bold.fnt)
%Fl(5,16-noto-sans.fnt)
%Fl(6,19-iclassic-icons.fnt)
%Fl(7,14-noto-sans.fnt)
#
#Battery: a frame per charge level, and the same while charging
%xl(battery,battery.bmp,0,4,8)
%xl(charging,battery_charging.bmp,0,4,8)
#
#Background layer
#
#- Title bar, 20px as on the iPod, and the list rule
%V(0,0,-,-,-)%VB%Vb(!000000)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_title_bar:),=,yes)<%dr(0,0,320,19,vivid<40:0056a5,vivid<40.50:002b52)|%dr(0,0,320,19,!4a4a4a,!161616)>
%dr(0,19,320,1,!505050)
#
#Foreground layer
#
#- Empty pane and its rule: its clear repaints the margins after
#  Cover Flow
%Vl(Pane,160,20,160,220,-)
%dr(0,0,1,220,!303030)
#
#- Cover or grey tile. Not in %VB, which nothing here copies to screen
%Vl(Pane,166,26,150,150,2)%Vy%Vg(!3a3a3a,!202020,!909090)
%?C<|%ac%Vs(gradient)b>
%Cl(0,0,150,150,c,c,-,-,framed)%Cd
#
#- Its reflection, fading into the pane
%Vl(Pane,166,176,150,18,-)
%Cd(framed,-,-,-,-,reflect,35)
#
#- Or the cover filling the pane, its middle 160 of 220 columns, as the
#  iPod shows it. Its %Cl claims a second art size whether shown or not
%Vl(Bleed,160,20,160,220,2)%Vy%Vg(!3a3a3a,!202020,!909090)
%?C<|%ac%Vs(gradient)b>
%Cl(-30,0,220,220,c,c,-,-,bleed)%Cd(bleed)
#- The menu's shadow on it, darkest at the edge
%dr(0,0,1,220,!000000,!000000,1)%dr(0,0,2,220,!000000,!000000,1)%dr(0,0,3,220,!000000,!000000,1)%dr(0,0,4,220,!000000,!000000,1)
#
#- Screen switches. 1x1 because a flip clears its line
%V(319,239,1,1,-)
%?if(%cs,=,22)<|%Vd(Chrome)%?if(%ft(themes/iclassic_square_dark.preferences,battery_number:),=,on)<%Vd(ChromeN)|%Vd(ChromeW)>>
%?if(%cs,=,10)<%Vd(QuickBg)%?if(%QT,!=,ERR)<%Vd(QuickT)>%?if(%QL,!=,ERR)<%Vd(QuickL)>%?if(%QR,!=,ERR)<%Vd(QuickR)>%?if(%QB,!=,ERR)<%Vd(QuickB)>>
%?if(%cs,=,22)<|%?Ld<|%?and(%LH,%if(%ft(themes/iclassic_square_dark.preferences,album_header:),!=,off))<%Vd(AlbumHead)|%?or(%if(%cs,=,1),%if(%cs,=,6),%if(%cs,=,12),%if(%cs,=,15),%if(%cs,=,16),%if(%cs,=,19),%and(%if(%cs,=,8),%or(%if(%Lt,=,Rockbox),%if(%Lt,=,%Sx(Music)),%if(%Lt,=,%Sx(Audiobooks)),%if(%Lt,=,%Sx(Podcasts)),%if(%Lt,=,%Sx(Custom menu)))),%and(%if(%cs,=,38),%if(%Lt,=,%Sx(Books))))<%?if(%ft(themes/iclassic_square_dark.preferences,menu_cover:),=,framed)<%Vd(Pane)|%Vd(Bleed)>|>>>>
%?and(%LD,%if(%ft(themes/iclassic_square_dark.preferences,episode_notes:),!=,off))<%Vd(Notes)>
#
#Rows, as the iPod's: art 44 across the whole screen, five full covers
#to the page; an album's tracks 24, numbered, under its header; any
#other list 24, a menu's beside the pane and the rest across the screen,
#each row choosing as it draws: the title it goes by is a draw behind
#when %Lb renders. A menu is the main menu, settings and the library's
#Music, Audiobooks, Podcasts and custom menus; in the library, Rockbox
#too, the main menu's title, which the library's first draw still has
%?Ld<%Lb(Rows,320,24,-,44)|%?if(%LH,=,album)<%Lb(Tracks,320,24)|%?or(%if(%cs,=,1),%if(%cs,=,6),%if(%cs,=,12),%if(%cs,=,15),%if(%cs,=,16),%if(%cs,=,19),%and(%if(%cs,=,8),%or(%if(%Lt,=,Rockbox),%if(%Lt,=,%Sx(Music)),%if(%Lt,=,%Sx(Audiobooks)),%if(%Lt,=,%Sx(Podcasts)),%if(%Lt,=,%Sx(Custom menu)))),%and(%if(%cs,=,38),%if(%Lt,=,%Sx(Books))))<%Lb(Rows,160,24,-,44)|%Lb(Rows,320,24,-,44)>>>
#
#Set up list
%Vi(list,0,20,160,220,3)%Vb(!000000)%Vf(!ffffff)
%Vi(full,0,20,320,220,3)%Vb(!000000)%Vf(!ffffff)
%Vi(album,0,72,320,168,3)%Vb(!000000)%Vf(!ffffff)
#- Under the header, over the notes: five rows
%Vi(albumnotes,0,72,320,120,3)%Vb(!000000)%Vf(!ffffff)
#- Over the notes: seven rows
%Vi(notes,0,20,320,168,3)%Vb(!000000)%Vf(!ffffff)
#- Cover Flow takes the whole screen, title bar and all
%Vi(covers,0,0,320,240,-)
#
#- Hidden list for the quick screen
%Vi(qsblank,0,0,1,1,-)
#
%V(318,239,1,1,-)%Vb(!000000)%Vf(!ffffff)%?if(%cs,=,10)<%VI(qsblank)|%?if(%cs,=,22)<%VI(covers)|%?Ld<%VI(full)|%?and(%LH,%if(%ft(themes/iclassic_square_dark.preferences,album_header:),!=,off))<%?and(%LD,%if(%ft(themes/iclassic_square_dark.preferences,episode_notes:),!=,off))<%VI(albumnotes)|%VI(album)>|%?and(%LD,%if(%ft(themes/iclassic_square_dark.preferences,episode_notes:),!=,off))<%VI(notes)|%?or(%if(%cs,=,1),%if(%cs,=,6),%if(%cs,=,12),%if(%cs,=,15),%if(%cs,=,16),%if(%cs,=,19),%and(%if(%cs,=,8),%or(%if(%Lt,=,Rockbox),%if(%Lt,=,%Sx(Music)),%if(%Lt,=,%Sx(Audiobooks)),%if(%Lt,=,%Sx(Podcasts)),%if(%Lt,=,%Sx(Custom menu)))),%and(%if(%cs,=,38),%if(%Lt,=,%Sx(Books))))<%VI(list)|%VI(full)>>>>>>
#
#- Empty title bar: its clear repaints what the three below leave,
#  once dynamic colours have recoloured the backdrop
%Vl(Chrome,0,0,320,20,-)
#
#- Play state, on the left as on the iPod
%Vl(Chrome,4,0,48,19,6)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_transport_icon:),=,yes)<%Vf(vivid>50:2e7cc6)|>%?mh<À|%?mp<|A|B|G|F>>
#
#- Title, centred between the two. ChromeW without the battery's number,
#  ChromeN with it, narrower by its width on each side
%Vl(ChromeW,56,1,208,17,4)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_title_text:),=,yes)<%Vf(vivid>50:2e7cc6)|>%ac%?if(%cs,=,10)<Quick Settings|%?if(%Lt,=,Rockbox)<iPod|%?and(%LH,%if(%ft(themes/iclassic_square_dark.preferences,album_header:),!=,off))<%sel(%LH,book,%Sx(Audiobooks),show,%Sx(Podcasts),%Sx(Album))|%s%Lt>>>
%Vl(ChromeN,84,1,152,17,4)%Vf(!ffffff)
%?if(%ft(themes/iclassic_square_dark.preferences,vivid_title_text:),=,yes)<%Vf(vivid>50:2e7cc6)|>%ac%?if(%cs,=,10)<Quick Settings|%?if(%Lt,=,Rockbox)<iPod|%?and(%LH,%if(%ft(themes/iclassic_square_dark.preferences,album_header:),!=,off))<%sel(%LH,book,%Sx(Audiobooks),show,%Sx(Podcasts),%Sx(Album))|%s%Lt>>>
#
#- Busy spinner, beside the battery or its number
%Vl(ChromeW,264,0,26,19,6)%Vf(!ffffff)
%ar%?or(%lh,%lb,%lw)<%?la<á|â|ã|ä|å|æ|ç|è>|>
%Vl(ChromeN,238,0,18,19,6)%Vf(!ffffff)
%ar%?or(%lh,%lb,%lw)<%?la<á|â|ã|ä|å|æ|ç|è>|>
#
#- The battery's number, "100%" wide, against the battery
%Vl(ChromeN,256,3,34,15,7)%Vf(!ffffff)
%ar%bl%%
#
#- Battery
%Vl(Chrome,292,0,26,19,-)
%?bc<%xd(charging,%bl)|%xd(battery,%bl)>
#
#- Plain row, the full width where there is no chevron
%Vl(Rows,0,0,160,24,3)%Vy
%?La<|%?or(%if(%cs,=,1),%if(%cs,=,6),%if(%cs,=,12),%if(%cs,=,15),%if(%cs,=,16),%if(%cs,=,19),%and(%if(%cs,=,8),%or(%if(%Lt,=,Rockbox),%if(%Lt,=,%Sx(Music)),%if(%Lt,=,%Sx(Audiobooks)),%if(%Lt,=,%Sx(Podcasts)),%if(%Lt,=,%Sx(Custom menu)))),%and(%if(%cs,=,38),%if(%Lt,=,%Sx(Books))))<%?and(%or(%if(%cs,!=,6),%if(%Lk,!=,1)),%or(%and(%if(%cs,!=,7),%if(%cs,!=,8),%if(%cs,!=,13),%if(%cs,!=,27),%if(%cs,!=,28)),%if(%Lk,!=,6)),%or(%if(%cs,!=,13),%if(%Lk,!=,8)))<%?Lc<%?if(%ft(themes/iclassic_square_dark.preferences,vivid_selection:),=,no)<%Vg(!ffffff,!c8c8c8,!000000)|%Vg(vivid>60:4d96e1,vivid>60.80:3e78b4,!000000)>%Vs(gradient)|%Vf(!ffffff)>%s %sel(%LT,%Sx([All Tracks]),%ss(1,10,%LT),%Sx([Random]),%ss(1,6,%LT),%Sx([Shuffle Albums]),%trm(%LT,[]),%Sx([Resume]),%ss(1,6,%LT),%Sx([Featured In]),%ss(1,11,%LT),%Sx([Untagged]),%ss(1,8,%LT),%Sx([By album]),%ss(1,8,%LT),%Sx(Finished),%trm(%LT,[]),%Sx(Not Started),%trm(%LT,[]),%Sx(In Progress),%trm(%LT,[]),%Sx(All Episodes),%trm(%LT,[]),%Sx([Play Unplayed]),%trm(%LT,[]),%LT)>|>>
#
#- Plain row beside a chevron. Only one of the two draws a
#  given row, so neither clears the other's text
%Vl(Rows,0,0,136,24,3)%Vy
%?La<|%?or(%if(%cs,=,1),%if(%cs,=,6),%if(%cs,=,12),%if(%cs,=,15),%if(%cs,=,16),%if(%cs,=,19),%and(%if(%cs,=,8),%or(%if(%Lt,=,Rockbox),%if(%Lt,=,%Sx(Music)),%if(%Lt,=,%Sx(Audiobooks)),%if(%Lt,=,%Sx(Podcasts)),%if(%Lt,=,%Sx(Custom menu)))),%and(%if(%cs,=,38),%if(%Lt,=,%Sx(Books))))<%?or(%and(%if(%cs,=,6),%if(%Lk,=,1)),%and(%or(%if(%cs,=,7),%if(%cs,=,8),%if(%cs,=,13),%if(%cs,=,27),%if(%cs,=,28)),%if(%Lk,=,6)),%and(%if(%cs,=,13),%if(%Lk,=,8)))<%?Lc<%?if(%ft(themes/iclassic_square_dark.preferences,vivid_selection:),=,no)<%Vg(!ffffff,!c8c8c8,!000000)|%Vg(vivid>60:4d96e1,vivid>60.80:3e78b4,!000000)>%Vs(gradient)|%Vf(!ffffff)>%s %sel(%LT,%Sx([All Tracks]),%ss(1,10,%LT),%Sx([Random]),%ss(1,6,%LT),%Sx([Shuffle Albums]),%trm(%LT,[]),%Sx([Resume]),%ss(1,6,%LT),%Sx([Featured In]),%ss(1,11,%LT),%Sx([Untagged]),%ss(1,8,%LT),%Sx([By album]),%ss(1,8,%LT),%Sx(Finished),%trm(%LT,[]),%Sx(Not Started),%trm(%LT,[]),%Sx(In Progress),%trm(%LT,[]),%Sx(All Episodes),%trm(%LT,[]),%Sx([Play Unplayed]),%trm(%LT,[]),%LT)>|>>
#
